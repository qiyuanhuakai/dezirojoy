# RPM spec for DeziroJoy. Build it with ./build-rpm.sh, which stages the
# payload and drives rpmbuild with the --define set below; do not feed this
# file to rpmbuild directly.
#
# The payload mirrors the .deb (../build-deb.sh) one for one: the complete
# self-contained publish output under /opt/dezirojoy - dezirojoy.ico and
# fix-device-access.sh included - the desktop entry, and the hicolor icon set.
# There are deliberately no scriptlets: install and removal stay side-effect
# free, login autostart and the elevated resident daemon remain opt-in features
# of the app itself (src/DeziroJoy.App/Program.cs), and nothing is written
# under /etc.

# Keep the payload exactly as published: no stripping, no build-id rewriting,
# no debuginfo subpackage. The .deb ships the unstripped binaries with their
# PDBs for the same reason - crash reports need the symbols - and the default
# brp-strip post-processing would silently rewrite the shipped ELFs.
%global debug_package %{nil}
%global __os_install_post %{nil}

Name:           dezirojoy
Version:        %{_version}
Release:        1%{?dist}
Summary:        gamepad to mouse/keyboard mapping tool
License:        MIT
URL:            https://github.com/qiyuanhuikai/dezirojoy
BuildArch:      %{_arch}

# Requires for the shipped binaries' DT_NEEDED sonames (libstdc++, libgcc_s,
# libfontconfig, the glibc pieces coreclr links, ...) are generated by
# rpmbuild itself through find-requires - not copied from the .deb's Depends,
# which uses Debian package names.
#
# ICU is the one dependency that generator cannot see: the .NET runtime
# dlopens libicuuc/libicui18n at startup instead of linking them (the .deb
# documents the same gap in ../build-deb.sh), and without system ICU the app
# FailFasts on an otherwise fully resolved install. These are soname
# requirements, resolved by each distro's own libicu package - never Debian
# package names. The range is what the runtime itself can load: it probes ICU
# versions from 60 up to its build version + 30 (dotnet/runtime
# pal_icushim.c), so 60 is the floor and the ceiling is headroom above the
# current releases. Append a soname when a distro ships a newer one, the same
# maintenance the .deb's versioned libicuXX alternatives document.
Requires: (libicuuc.so.60()(64bit) or libicuuc.so.61()(64bit) or libicuuc.so.62()(64bit) or libicuuc.so.63()(64bit) or libicuuc.so.64()(64bit) or libicuuc.so.65()(64bit) or libicuuc.so.66()(64bit) or libicuuc.so.67()(64bit) or libicuuc.so.68()(64bit) or libicuuc.so.69()(64bit) or libicuuc.so.70()(64bit) or libicuuc.so.71()(64bit) or libicuuc.so.72()(64bit) or libicuuc.so.73()(64bit) or libicuuc.so.74()(64bit) or libicuuc.so.75()(64bit) or libicuuc.so.76()(64bit) or libicuuc.so.77()(64bit) or libicuuc.so.78()(64bit) or libicuuc.so.79()(64bit) or libicuuc.so.80()(64bit))

%description
DeziroJoy maps gamepad input to mouse and keyboard movement with per-device
profiles, a radial deadzone, response curves and sub-pixel accumulation. The
GUI is built with Avalonia; input is read through evdev and injected through
uinput on Linux, XInput and SendInput on Windows.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
cp -a %{_stage}/. %{buildroot}/

%files
# The rpm counterpart of the .deb's dpkg-deb --root-owner-group: the package
# always ships root-owned files no matter which user ran the build (the mode
# stays whatever the staging produced, like the .deb). Without it an rpm built
# by an unprivileged CI user would install its files owned by that user's uid.
%defattr(-, root, root)
%dir /opt/dezirojoy
/opt/dezirojoy/*
/usr/share/applications/dezirojoy.desktop
/usr/share/icons/hicolor/*/apps/dezirojoy.png
