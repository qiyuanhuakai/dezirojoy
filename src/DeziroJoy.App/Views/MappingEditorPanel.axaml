<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             xmlns:views="clr-namespace:DeziroJoy.App.Views"
             x:Class="DeziroJoy.App.Views.MappingEditorPanel"
             x:DataType="vm:MappingEditorViewModel">

    <!--
        The mapping editor's card content. The gesture switcher leads: 单击 / 双击 / 长按 are
        three equal peers, and the one target editor below it is bound to Editor.ActiveSlot, so
        the same controls configure whichever slot the switcher has selected. The optional
        key picker sits in a collapsed expander - a category navigator over one compact grid of
        key caps - so the editor opens compact and the model above it stays in view.

        The card frame itself - its border, background, slide/fade motion and visibility -
        stays on the EditorPanel border in MainWindow, so this panel is only the content that
        border hosts. The header row is outside the scrolling body, so 确定/取消 never scroll
        out of reach.

        The panel is a view over one MappingEditorViewModel: the host binds it as
        DataContext="{Binding Editor}", so every path here is relative to the editor. The two
        header buttons act on the window's orchestration (commit/cancel the edit), so their
        commands reach the window's view model through the Window ancestor.
    -->

    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="Not" />
        <conv:TargetKindMatchConverter x:Key="KindMatch" />
        <views:TargetKindLabelConverter x:Key="TargetKindLabel" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- A plain ItemsControl wraps each item in a ContentPresenter whose content
             alignment defaults to Left, which would leave every key cap at its label's
             width instead of filling its cell of the grid. The generated containers
             stretch, so the caps do. The selector is scoped to the key grid: the category
             navigator's segments are RadioButtons that must keep their label's width, or
             every segment would claim the navigator's whole width, one per row. -->
        <Style Selector="ItemsControl.keyGrid ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!-- The categorized key grid's well: one sunken surface behind every category, so
             the grid reads as a single picker rather than six floating lists. -->
        <Style Selector="Border.pickerWell">
            <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- The category navigator: one segmented row where every category is an equal peer,
             the same idiom - and the same surface language - as the gesture switcher above.
             The checked segment carries the accent surface, so the category whose keys are on
             screen is never in doubt. Segments wrap rather than scroll: the navigator must
             stay reachable without a second scrollbar, and six short names fit the card's
             width on one row at every size the window allows. -->
        <Style Selector="RadioButton.keyCategorySegment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.keyCategorySegment:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="RadioButton.keyCategorySegment:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- A key cap: a focusable button that keeps one box in every state. Its surface is
             the design system's own key-cap border, washed by the selection, and the check
             glyph fades in beside the label, so the selected state never rests on colour
             alone. The alignment is explicit because the Button theme's own Left alignment
             would leave every cap at its label's width instead of filling its cell of
             the grid. -->
        <Style Selector="Button.keyCap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Classes="keyCapFrame" Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="Transparent"
                            CornerRadius="{DynamicResource CornerRadiusMd}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.keyCap:pointerover Border.keyCap">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="Button.keyCap:pressed Border.keyCap">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <!-- Keyboard focus rings the cap itself in the accent - the same ink the mapping
             rows wear - so a keyboard user always sees where the selection would land. The
             border thickness never changes, so focusing a cap shifts nothing. -->
        <Style Selector="Button.keyCap:focus Border.keyCapFrame">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.keyCap:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- The selected cap's surface: the same key-cap border, washed in the accent tone.
             One surface per cap rather than two stacked ones, so a resting cap can never
             show the selected tone by sitting on top of it. -->
        <Style Selector="Button.keyCap.selected Border.keyCap">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
        </Style>

        <Style Selector="Button.keyCap TextBlock.keyCapLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
        </Style>

        <Style Selector="Button.keyCap.selected TextBlock.keyCapLabel">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.keyCap TextBlock.keyCapCheck">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Button.keyCap.selected TextBlock.keyCapCheck">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The interval editor wears the same form-control chrome the combo boxes do. -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="编辑映射" />
                <TextBlock Text="{Binding SourceDescription}" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding ActiveTargetDescription}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CommitButton" Classes="primary" Content="确定" MinHeight="32"
                        Command="{ReflectionBinding DataContext.CommitEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button x:Name="CancelButton" Classes="ghost" Content="取消" MinHeight="32"
                        Margin="8,0,0,0"
                        Command="{ReflectionBinding DataContext.CancelEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- The switcher. One segmented control where all three gestures are equally
                     reachable - the double-click and the long-press are peers of the click,
                     not extras buried under it. It leads the editor, so the gesture is chosen
                     before the target it fires. -->
                <StackPanel x:Name="GestureRow" IsVisible="{Binding SourceIsStick, Converter={StaticResource Not}}">
                    <TextBlock Classes="sectionLabel" Text="手势" />
                    <TextBlock Classes="hint" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="单击、双击、长按是三种平等的手势：选择要配置的一种，再设置它的功能（可设为无功能）。" />

                    <Border x:Name="GestureSwitcher" Background="{DynamicResource SubtleBrush}"
                            CornerRadius="{DynamicResource CornerRadiusMd}"
                            Padding="3" Margin="0,0,0,10" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GestureClickTab" Classes="gestureSegment" GroupName="GestureSlots"
                                         Content="单击" IsChecked="{Binding IsClickSelected, Mode=TwoWay}" />
                            <RadioButton x:Name="GestureDoubleClickTab" Classes="gestureSegment" GroupName="GestureSlots"
                                         Content="双击" IsChecked="{Binding IsDoubleClickSelected, Mode=TwoWay}" />
                            <RadioButton x:Name="GestureLongPressTab" Classes="gestureSegment" GroupName="GestureSlots"
                                         Content="长按" IsChecked="{Binding IsLongPressSelected, Mode=TwoWay}"
                                         IsEnabled="{Binding LongPressAvailable}" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-repeat and the long-press are mutually exclusive: while repeat runs
                         the long-press branch is unavailable, and the reason is stated rather
                         than left to guesswork. -->
                    <TextBlock x:Name="GestureRepeatHint" Classes="hint" Margin="0,0,0,10"
                               IsVisible="{Binding ClickRepeatEnabled}"
                               Text="「长按重复触发」已启用：重复触发与长按互斥，长按手势暂不可用。关闭重复触发后即可配置长按。" />

                    <!-- Auto-repeat belongs to the click alone: it re-fires the click's own
                         target, so it is offered on the click's tab and nowhere else. The
                         wording names the behaviour only - the interval below carries the
                         number, so the label never pins a value the user can change. -->
                    <CheckBox x:Name="GestureClickRepeatBox" Content="长按重复触发"
                              IsVisible="{Binding IsClickSelected}"
                              IsChecked="{Binding ClickRepeatEnabled, Mode=TwoWay}" />

                    <!-- The repeat interval, offered once repeat is on: the click tab's own
                         control, so it waits for the same tab and the same checkbox. The
                         range and the step are the editor's contract; the value written is
                         the one the profile round-trips. -->
                    <StackPanel x:Name="ClickRepeatIntervalRow" Orientation="Horizontal" Margin="4,8,0,0"
                                IsVisible="{Binding ShowClickRepeatInterval}">
                        <StackPanel Width="150">
                            <TextBlock Classes="fieldLabel" Text="重复间隔（秒）" />
                            <NumericUpDown x:Name="ClickRepeatIntervalBox" Width="140"
                                           Minimum="0.05" Maximum="2.00" Increment="0.05"
                                           FormatString="0.00"
                                           Value="{Binding ClickRepeatIntervalSeconds, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Classes="hint" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="按住时重复触发单击的间隔，范围 0.05–2.00 秒，步进 0.05 秒。" />
                    </StackPanel>
                </StackPanel>

                <!-- The shared target editor. Every control below reads and writes the active
                     slot, so the three gestures are configured through one surface instead of
                     a click-only editor plus two buried dropdowns. -->
                <TextBlock Classes="sectionLabel" Text="目标动作" />

                <!-- 已关闭 is the gesture's own off state: it never resolves, so no timing
                     window is written and a fast double-press simply fires the click twice.
                     The click has no such state - it is the mapping's own target - so the row
                     is offered for the two gestures alone. -->
                <StackPanel x:Name="ActiveGestureRow" IsVisible="{Binding ActiveGestureCanBeDisabled}">
                    <CheckBox x:Name="ActiveGestureEnabledBox" Content="启用手势"
                              IsChecked="{Binding ActiveGestureEnabled, Mode=TwoWay}" />
                    <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                               IsVisible="{Binding ActiveGestureEnabled, Converter={StaticResource Not}}"
                               Text="手势已关闭：该手势不会触发，双击或长按都只按单击处理。勾选「启用手势」后即可配置它的功能。" />
                </StackPanel>

                <WrapPanel IsEnabled="{Binding ActiveTargetEditable}">
                    <StackPanel Width="230" Margin="0,0,12,0">
                        <TextBlock Classes="fieldLabel" Text="类型" />
                        <!-- The label comes from the panel's own converter rather than the
                             shared enumCombo template: the shared one falls back to the raw
                             enum name for 特殊键, the kind this panel adds. -->
                        <ComboBox x:Name="TargetKindCombo" Classes="enumCombo"
                                  ItemsSource="{Binding AvailableTargetKinds}"
                                  SelectedItem="{Binding ActiveTargetKind, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TargetKindLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="DirectionRow" Width="230" Margin="0,0,12,0"
                                IsVisible="{Binding ShowDirectionPicker}">
                        <TextBlock Classes="fieldLabel" Text="方向" />
                        <!-- The two cross combinations cannot work without a direction the
                             engine cannot guess: a stick driving a digital target has to say
                             which deflection presses it, a button driving a continuous one
                             which way it deflects. The row waits for the combination, so a
                             native pairing never offers a direction that would be ignored,
                             and the choice is written into the mapping on commit. -->
                        <ComboBox x:Name="DirectionCombo" Classes="enumCombo"
                                  ItemsSource="{Binding DirectionOptions}"
                                  SelectedItem="{Binding SelectedDirectionOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DirectionPickerItem">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="MouseTargetRow" Width="230"
                                IsVisible="{Binding ActiveTargetKind, Converter={StaticResource KindMatch}, ConverterParameter=MouseButton}">
                        <TextBlock Classes="fieldLabel" Text="鼠标按键" />
                        <ComboBox x:Name="MouseButtonCombo" Classes="enumCombo"
                                  ItemsSource="{x:Static views:EnumOptions.MouseButtons}"
                                  SelectedItem="{Binding ActiveSelectedMouseButton, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" IsVisible="{Binding ShowButtonPicker}">
                        <TextBlock Classes="fieldLabel" Text="键盘直接输入" />
                        <Button x:Name="CaptureKeyButton" Classes="ghost" MinHeight="32"
                                Content="{Binding CaptureKeyLabel}"
                                Command="{Binding ToggleCaptureKeyCommand}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Classes="hint" Margin="0,8,0,0" IsVisible="{Binding IsCapturingKey}"
                           Text="正在捕获键盘：按下目标按键（可含 Ctrl/Shift/Alt/Win 组合），全部松开即完成。" />

                <!-- The optional categorized key grid. Collapsed by default so the editor
                     opens compact; expanding it reveals the grid without moving anything
                     above it out of view, and the selection survives both states. Inside, a
                     category navigator leads and one compact grid of key caps follows: the
                     card is wide and short, so stacking all six categories as one long list
                     would trade the card's width for a scroll the user pays on every key.
                     Instead the navigator spends the width - every category one segment away,
                     always reachable, never scrolled past - and the grid shows the chosen
                     category's keys packed as densely as its labels allow. The grid owns no
                     scrollbar - the editor body above scrolls it - so a selection never
                     snaps the list to the top, and the category follows the selection, so the
                     key that is selected is the key that is in view. -->
                <Expander x:Name="KeyPickerExpander" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                          IsExpanded="{Binding KeyPickerExpanded, Mode=TwoWay}"
                          IsVisible="{Binding ActiveTargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyPress|KeyCombo}">
                    <Expander.Header>
                        <TextBlock Classes="fieldLabel" Text="或从列表选择" Margin="0" />
                    </Expander.Header>
                    <Border Classes="pickerWell" IsEnabled="{Binding ActiveTargetEditable}">
                        <StackPanel>
                            <ItemsControl x:Name="KeyCategoryNav" ItemsSource="{Binding KeyCategoryGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyCategoryGroup">
                                        <RadioButton Classes="keyCategorySegment" GroupName="KeyCategoryNav"
                                                     Content="{Binding Name}"
                                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="KeyCategoryGrid" Classes="keyGrid"
                                          ItemsSource="{Binding ActiveKeyCategory.Keys}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding ActiveKeyCategoryColumns}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyPickerItem">
                                        <Button Classes="keyCap"
                                                 Loaded="OnKeyCapLoaded" Click="OnKeyCapClick">
                                            <!-- The label and the check glyph share the cap
                                                 without overlapping: the glyph owns a reserved
                                                 strip at the right, so a long name such as
                                                 PageDown never runs under it however densely
                                                 the grid packs the row. -->
                                            <Grid ColumnDefinitions="*,14">
                                                <Border Classes="keyCap" Grid.ColumnSpan="2" />
                                                <TextBlock Grid.Column="0" Classes="keyCapLabel" Text="{Binding Label}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="keyCapCheck" Text="✓"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                                            Margin="0,1,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>

                <StackPanel x:Name="ModifierRow" Orientation="Horizontal" Margin="0,10,0,0"
                            IsEnabled="{Binding ActiveTargetEditable}"
                            IsVisible="{Binding ActiveTargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyCombo}">
                    <CheckBox x:Name="ModifierCtrlBox" Content="Ctrl" IsChecked="{Binding ActiveModifierCtrl, Mode=TwoWay}" />
                    <CheckBox x:Name="ModifierShiftBox" Content="Shift" Margin="14,0,0,0" IsChecked="{Binding ActiveModifierShift, Mode=TwoWay}" />
                    <CheckBox x:Name="ModifierAltBox" Content="Alt" Margin="14,0,0,0" IsChecked="{Binding ActiveModifierAlt, Mode=TwoWay}" />
                    <CheckBox x:Name="ModifierWinBox" Content="Win" Margin="14,0,0,0" IsChecked="{Binding ActiveModifierWin, Mode=TwoWay}" />
                </StackPanel>

                <!-- What the slot does beyond a target. 无功能 is explicit for every slot; the
                     legacy repeat-the-click state stays reachable for the two gestures without
                     standing in the way. This row is gated on the gesture resolving alone, not
                     on ActiveTargetEditable: checking 无功能 disables the target parameters
                     above, and gating this row the same way would disable the very box that
                     takes 无功能 back. A gesture that is 已关闭 has no function to choose yet,
                     so the row waits for 启用手势, exactly as the parameters do. -->
                <StackPanel Margin="0,12,0,0" IsEnabled="{Binding ActiveGestureEnabled}">
                    <CheckBox x:Name="ActiveNoneBox" Content="无功能（不触发任何操作）"
                              IsChecked="{Binding ActiveIsNone, Mode=TwoWay}" />
                    <CheckBox x:Name="ActiveRepeatBox" Content="重复单击的功能（沿用单击的目标）"
                              Margin="0,8,0,0"
                              IsVisible="{Binding ActiveGestureCanBeDisabled}"
                              IsChecked="{Binding ActiveRepeatsClick, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel x:Name="MouseMoveRow" IsEnabled="{Binding ActiveTargetEditable}"
                            IsVisible="{Binding ActiveTargetKind, Converter={StaticResource KindMatch}, ConverterParameter=MouseMove}">
                    <TextBlock Classes="sectionLabel" Text="鼠标移动参数" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="最高速度 (px/s)" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorMouseMaxSpeedBox" Minimum="100" Maximum="6000" TickFrequency="50"
                                Value="{Binding ActiveMouseSettings.MaxSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActiveMouseSettings.MaxSpeed, StringFormat='{}{0:F0}'}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorMouseDeadZoneBox" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                Value="{Binding ActiveMouseSettings.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActiveMouseSettings.DeadZone, StringFormat='{}{0:F2}'}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="平滑时间 (s)" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorMouseResponseTimeBox" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                                Value="{Binding ActiveMouseSettings.ResponseTime, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActiveMouseSettings.ResponseTime, StringFormat='{}{0:F2}'}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="精准按键" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="EditorPrecisionButtonCombo" Classes="enumCombo" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding PrecisionButtonOptions}"
                                  SelectedItem="{Binding ActivePrecisionButton, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Classes="hint" Margin="150,4,0,0"
                               Text="按住该键时鼠标按精准倍率降速；每个映射独立保存。" />
                </StackPanel>

                <StackPanel x:Name="WheelRow" IsEnabled="{Binding ActiveTargetEditable}"
                            IsVisible="{Binding ActiveTargetKind, Converter={StaticResource KindMatch}, ConverterParameter=WheelScroll}">
                    <TextBlock Classes="sectionLabel" Text="滚轮参数" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="滚动速率 (格/s)" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorScrollRateBox" Minimum="1" Maximum="40" TickFrequency="1"
                                Value="{Binding ActiveScrollSettings.MaxTicksPerSecond, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActiveScrollSettings.MaxTicksPerSecond, StringFormat='{}{0:F0}'}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorScrollDeadzoneBox" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                Value="{Binding ActiveScrollSettings.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ActiveScrollSettings.DeadZone, StringFormat='{}{0:F2}'}" />
                    </Grid>
                </StackPanel>

                <!-- 特殊键. The sub-kind leads and only the controls that sub-kind reads
                     follow: 精准键 carries its trigger mode, Leader 键 carries the switch
                     mode and the two preset slots it flips between. Equal slots are refused
                     with the same explanatory hint the gesture exclusion uses. -->
                <StackPanel x:Name="SpecialKeyRow" Margin="0,12,0,0"
                            IsEnabled="{Binding ActiveTargetEditable}"
                            IsVisible="{Binding ActiveTargetKind, Converter={StaticResource KindMatch}, ConverterParameter=SpecialKey}">
                    <TextBlock Classes="sectionLabel" Text="特殊键" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="子类型" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="SpecialKindCombo" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SpecialKindOptions}"
                                  SelectedItem="{Binding ActiveSpecialKindOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpecialKeyKindOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="SpecialPrecisionModeRow" Margin="0,8,0,0" IsVisible="{Binding ShowSpecialPrecisionControls}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="触发方式" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="SpecialPrecisionModeCombo" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SpecialPrecisionModeOptions}"
                                  SelectedItem="{Binding ActiveSpecialPrecisionModeOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PrecisionModeOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="SpecialSwitchModeRow" Margin="0,8,0,0" IsVisible="{Binding ShowSpecialLeaderControls}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="切换方式" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="SpecialSwitchModeCombo" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SpecialSwitchModeOptions}"
                                  SelectedItem="{Binding ActiveSpecialSwitchModeOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderSwitchModeOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="SpecialSlotARow" Margin="0,8,0,0" IsVisible="{Binding ShowSpecialLeaderControls}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="槽位 A" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="SpecialSlotACombo" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SpecialSlotOptions}"
                                  SelectedItem="{Binding ActiveSpecialSlotA, Mode=TwoWay}" />
                    </Grid>
                    <Grid x:Name="SpecialSlotBRow" Margin="0,8,0,0" IsVisible="{Binding ShowSpecialLeaderControls}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="槽位 B" VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="SpecialSlotBCombo" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SpecialSlotOptions}"
                                  SelectedItem="{Binding ActiveSpecialSlotB, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock x:Name="SpecialSlotHint" Classes="hint" Margin="150,6,0,0" TextWrapping="Wrap"
                               IsVisible="{Binding SpecialKeySlotConflict}"
                               Text="Leader 键的两个槽位不能相同：请为槽位 A 与槽位 B 选择不同的预设，否则按下该键不会切换任何配置。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
