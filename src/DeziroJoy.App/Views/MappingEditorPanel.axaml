<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             xmlns:views="clr-namespace:DeziroJoy.App.Views"
             x:Class="DeziroJoy.App.Views.MappingEditorPanel"
             x:DataType="vm:MappingEditorViewModel">

    <!--
        The mapping editor's card content: the header (what is being edited, plus 确定/取消)
        and the scrolling body (target action, key list, modifiers, stick parameters and the
        gesture switcher). The card frame itself - its border, background, slide/fade motion
        and visibility - stays on the EditorPanel border in MainWindow, so this panel is only
        the content that border hosts.

        The panel is a view over one MappingEditorViewModel: the host binds it as
        DataContext="{Binding Editor}", so every path here is relative to the editor. The two
        header buttons act on the window's orchestration (commit/cancel the edit), so their
        commands reach the window's view model through the Window ancestor.
    -->

    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="Not" />
        <conv:TargetKindMatchConverter x:Key="KindMatch" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="编辑映射" />
                <TextBlock Text="{Binding SourceDescription}" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding TargetDescription}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CommitButton" Classes="primary" Content="确定"
                        Command="{ReflectionBinding DataContext.CommitEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button x:Name="CancelButton" Classes="ghost" Content="取消"
                        Margin="8,0,0,0" Command="{ReflectionBinding DataContext.CancelEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Classes="sectionLabel" Text="目标动作" />
                <WrapPanel IsEnabled="{Binding ClickIsNone, Converter={StaticResource Not}}">
                    <StackPanel Width="230" Margin="0,0,12,0">
                        <TextBlock Classes="fieldLabel" Text="类型" />
                        <ComboBox x:Name="TargetKindCombo" Classes="enumCombo"
                                  ItemsSource="{Binding AvailableTargetKinds}"
                                  SelectedItem="{Binding TargetKind, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel x:Name="MouseTargetRow" Width="230"
                                IsVisible="{Binding TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=MouseButton}">
                        <TextBlock Classes="fieldLabel" Text="鼠标按键" />
                        <ComboBox x:Name="MouseButtonCombo" Classes="enumCombo"
                                  ItemsSource="{x:Static views:EnumOptions.MouseButtons}"
                                  SelectedItem="{Binding SelectedMouseButton, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" IsVisible="{Binding ShowButtonPicker}">
                        <TextBlock Classes="fieldLabel" Text="键盘直接输入" />
                        <Button x:Name="CaptureKeyButton" Classes="ghost"
                                Content="{Binding CaptureKeyLabel}"
                                Command="{Binding ToggleCaptureKeyCommand}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Classes="hint" Margin="0,8,0,0" IsVisible="{Binding IsCapturingKey}"
                           Text="正在捕获键盘：按下目标按键（可含 Ctrl/Shift/Alt/Win 组合），全部松开即完成。" />

                <TextBlock Classes="sectionLabel" Text="或从列表选择"
                           IsVisible="{Binding TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyPress|KeyCombo}" />
                <ListBox x:Name="TargetKeyList" Classes="pickerList" MaxHeight="240"
                         IsEnabled="{Binding ClickIsNone, Converter={StaticResource Not}}"
                         IsVisible="{Binding TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyPress|KeyCombo}"
                         ItemsSource="{Binding KeyOptions}"
                         SelectedItem="{Binding SelectedKeyOption, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyPickerItem">
                            <Panel>
                                <Border Classes="pickerHeader" IsVisible="{Binding IsHeader}" Padding="12,12,12,5">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="3" Height="9" VerticalAlignment="Center"
                                                CornerRadius="{DynamicResource CornerRadiusSm}"
                                                Background="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Classes="pickerHeaderLabel" Text="{Binding Label}" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                                <Border Classes="keyCap" IsVisible="{Binding IsHeader, Converter={StaticResource Not}}"
                                        Padding="12,7" MinHeight="30">
                                    <TextBlock Classes="keyCapLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="ModifierRow" Orientation="Horizontal" Margin="0,10,0,0"
                            IsEnabled="{Binding ClickIsNone, Converter={StaticResource Not}}"
                            IsVisible="{Binding TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyCombo}">
                    <CheckBox x:Name="ModifierCtrlBox" Content="Ctrl" IsChecked="{Binding ModifierCtrl, Mode=TwoWay}" />
                    <CheckBox x:Name="ModifierShiftBox" Content="Shift" Margin="14,0,0,0" IsChecked="{Binding ModifierShift, Mode=TwoWay}" />
                    <CheckBox x:Name="ModifierAltBox" Content="Alt" Margin="14,0,0,0" IsChecked="{Binding ModifierAlt, Mode=TwoWay}" />
                    <CheckBox x:Name="ModifierWinBox" Content="Win" Margin="14,0,0,0" IsChecked="{Binding ModifierWin, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel x:Name="MouseMoveRow" IsEnabled="{Binding ClickIsNone, Converter={StaticResource Not}}"
                            IsVisible="{Binding TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=MouseMove}">
                    <TextBlock Classes="sectionLabel" Text="鼠标移动参数" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="最高速度 (px/s)" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorMouseMaxSpeedBox" Minimum="100" Maximum="6000" TickFrequency="50"
                                Value="{Binding MouseSettings.MaxSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding MouseSettings.MaxSpeed, StringFormat='{}{0:F0}'}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorMouseDeadZoneBox" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                Value="{Binding MouseSettings.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding MouseSettings.DeadZone, StringFormat='{}{0:F2}'}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="平滑时间 (s)" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorMouseResponseTimeBox" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                                Value="{Binding MouseSettings.ResponseTime, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding MouseSettings.ResponseTime, StringFormat='{}{0:F2}'}" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WheelRow" IsEnabled="{Binding ClickIsNone, Converter={StaticResource Not}}"
                            IsVisible="{Binding TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=WheelScroll}">
                    <TextBlock Classes="sectionLabel" Text="滚轮参数" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="滚动速率 (格/s)" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorScrollRateBox" Minimum="1" Maximum="40" TickFrequency="1"
                                Value="{Binding ScrollSettings.MaxTicksPerSecond, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ScrollSettings.MaxTicksPerSecond, StringFormat='{}{0:F0}'}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" x:Name="EditorScrollDeadzoneBox" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                Value="{Binding ScrollSettings.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ScrollSettings.DeadZone, StringFormat='{}{0:F2}'}" />
                    </Grid>
                </StackPanel>

                <!-- Gestures. 单击 / 双击 / 长按 are three equal peers chosen
                     through one switcher; the action for the selected gesture
                     is configured below it. The timings are the Core's pinned
                     defaults, so there are no sliders here. Button sources
                     only, since the engine attaches a gesture to a
                     ButtonBinding. -->
                <StackPanel x:Name="GestureRow" IsVisible="{Binding SourceIsStick, Converter={StaticResource Not}}">
                    <TextBlock Classes="sectionLabel" Text="手势" />
                    <TextBlock Classes="hint" Margin="0,0,0,8"
                               Text="单击、双击、长按是三种平等的手势：选择要配置的一种，再设置它的功能（可设为无功能）。" />

                    <!-- The switcher. One segmented control where all three
                         gestures are equally reachable - the double-click and
                         the long-press are peers of the click, not extras
                         buried under it. -->
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="{DynamicResource CornerRadiusMd}"
                            Padding="3" Margin="0,0,0,10" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GestureClickTab" Classes="gestureSegment" GroupName="GestureSlots"
                                         Content="单击" IsChecked="{Binding IsClickSelected, Mode=TwoWay}" />
                            <RadioButton x:Name="GestureDoubleClickTab" Classes="gestureSegment" GroupName="GestureSlots"
                                         Content="双击" IsChecked="{Binding IsDoubleClickSelected, Mode=TwoWay}" />
                            <RadioButton x:Name="GestureLongPressTab" Classes="gestureSegment" GroupName="GestureSlots"
                                         Content="长按" IsChecked="{Binding IsLongPressSelected, Mode=TwoWay}"
                                         IsEnabled="{Binding LongPressAvailable}" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-repeat and the long-press are mutually exclusive:
                         while repeat runs the long-press branch is unavailable,
                         and the reason is stated rather than left to guesswork. -->
                    <TextBlock x:Name="GestureRepeatHint" Classes="hint" Margin="0,0,0,10"
                               IsVisible="{Binding ClickRepeatEnabled}"
                               Text="「长按重复触发」已启用：重复触发与长按互斥，长按手势暂不可用。关闭重复触发后即可配置长按。" />

                    <!-- 单击: the mapping's own target, which can be set to
                         无功能, plus the auto-repeat option that belongs to
                         the click alone. -->
                    <StackPanel x:Name="GestureClickBranch" IsVisible="{Binding IsClickSelected}">
                        <CheckBox x:Name="GestureClickNoneBox" Content="无功能（单击不触发任何操作）"
                                  IsChecked="{Binding ClickIsNone, Mode=TwoWay}" />
                        <TextBlock Classes="hint" Margin="0,4,0,0" IsVisible="{Binding ClickIsNone}"
                                   Text="单击已设为无功能：上方「目标动作」不会生效，按下时什么都不会发生。" />
                        <CheckBox x:Name="GestureClickRepeatBox" Content="长按重复触发（按住时每 0.10 秒重复一次单击）"
                                  Margin="0,10,0,0" IsChecked="{Binding ClickRepeatEnabled, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 双击: what the double-click emits. 无功能 makes it
                         resolve and emit nothing; 重复单击的功能 re-fires the
                         mapping's own target. -->
                    <StackPanel x:Name="GestureDoubleClickBranch" IsVisible="{Binding IsDoubleClickSelected}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="双击时执行" VerticalAlignment="Center" Margin="0" />
                            <ComboBox Grid.Column="1" x:Name="GestureDoubleClickActionCombo" Classes="enumCombo"
                                      ItemsSource="{Binding GestureActionOptions}"
                                      SelectedItem="{Binding SelectedDoubleClickOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <!-- 长按: what the long-press emits, on the same rows. -->
                    <StackPanel x:Name="GestureLongPressBranch" IsVisible="{Binding IsLongPressSelected}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="长按时执行" VerticalAlignment="Center" Margin="0" />
                            <ComboBox Grid.Column="1" x:Name="GestureLongPressActionCombo" Classes="enumCombo"
                                      ItemsSource="{Binding GestureActionOptions}"
                                      SelectedItem="{Binding SelectedLongPressOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
