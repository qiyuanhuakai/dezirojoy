<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
        xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
        xmlns:controls="clr-namespace:DeziroJoy.App.Views.Controls"
        xmlns:views="clr-namespace:DeziroJoy.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="DeziroJoy.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DeziroJoy"
        Width="1320" Height="880"
        MinWidth="1180" MinHeight="780"
         WindowStartupLocation="CenterScreen"
         WindowDecorations="None"
         ExtendClientAreaToDecorationsHint="True"
         ExtendClientAreaTitleBarHeightHint="44"
         Opened="OnWindowOpened"
         Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="DotBrush" PressedKey="ConnectedBrush" IdleKey="IdleDotBrush" />
        <conv:BoolToTextConverter x:Key="EngineStateText" TrueText="停止映射" FalseText="启动映射" />
        <conv:BoolToTextConverter x:Key="EnabledText" TrueText="已启用" FalseText="已禁用" />
        <conv:BoolNegationConverter x:Key="Not" />
        <conv:LayoutToTextConverter x:Key="LayoutText" />
        <conv:TargetKindMatchConverter x:Key="KindMatch" />
        <conv:EnumDisplayConverter x:Key="EnumDisplay" />
        <conv:ScrollRateBarConverter x:Key="RateBar" />
        <conv:RowSelectedConverter x:Key="RowSelected" />
        <conv:BoolToRowHeightConverter x:Key="EditorRowHeight" />
        <conv:BoolToBrushConverter x:Key="TransferMessageBrush" PressedKey="DangerBrush" IdleKey="HintTextBrush" />

        <!-- Motion targets for the mapping surface. Each drives one animated property, so the
             animation lives in a DoubleTransition on the target and these only say where the
             property has to end up:
               EditorLift  the model rises while the editor is open, clearing the card below
               EditorSlide the editor card settles up into its slot as it appears
               EditorFade  the editor card's opacity, 0 at rest and 1 while open -->
        <conv:BoolToDoubleConverter x:Key="EditorLift" TrueValue="-24" FalseValue="0" />
        <conv:BoolToDoubleConverter x:Key="EditorSlide" TrueValue="0" FalseValue="14" />
        <conv:BoolToDoubleConverter x:Key="EditorFade" TrueValue="1" FalseValue="0" />
        <conv:BoolToDoubleConverter x:Key="RowTintFade" TrueValue="1" FalseValue="0" />

        <!-- One source row. Shared by the left and the right column of the mapping surface so
             both sides render identically. The selected row carries a full-bleed tint behind
             its content as well as the accent bar: a 3px bar alone reads as a sliver among a
             wall of cards. Clicking the row opens its settings, so there is no separate edit
             button - only the enable toggle and delete remain.

             Under the source, the row is the complete summary of the three gestures the
             mapping carries (DESIGN 4.3.8): 单击 / 双击 / 长按 each get one line with a fixed
             category label, so the three functions align in one column instead of squeezing
             into three narrow ones. 已关闭, 无功能 and the legacy 重复单击的功能 are three
             different states and read differently here, exactly as they do in the editor. -->
        <DataTemplate x:Key="MappingRowTemplate" DataType="vm:MappingRowViewModel">
            <controls:MappingRowBorder Classes="card mappingRow" Padding="0" Margin="0,0,0,6">
                <Grid>
                    <!-- The tint bleeds one pixel past its slot on every side. The row's card
                         border insets its children, so without the bleed a selected row would
                         read as a tint floating inside a hairline rather than one full-bleed
                         surface; the radius stays concentric with the card's. -->
                    <Border CornerRadius="{DynamicResource CornerRadiusXl}" Margin="-1"
                            Background="{DynamicResource RowSelectedBrush}"
                            Opacity="{Binding IsVisible, RelativeSource={RelativeSource Self}, Converter={StaticResource RowTintFade}}">
                        <!-- The tint fades in rather than snapping on. Its opacity follows its own
                             visibility, so the fade rides the selection MultiBinding below without
                             a second copy of it: visibility is what removes the tint from an
                             unselected row entirely, and opacity is what makes it arrive. -->
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" />
                            </Transitions>
                        </Border.Transitions>
                        <Border.IsVisible>
                            <MultiBinding Converter="{StaticResource RowSelected}">
                                <Binding />
                                <Binding Path="DataContext.(vm:MainWindowViewModel).SelectedMapping"
                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                    <Border Width="3" Margin="0,8,0,8" CornerRadius="{DynamicResource CornerRadiusSm}"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Background="{DynamicResource AccentBrush}">
                        <Border.IsVisible>
                            <MultiBinding Converter="{StaticResource RowSelected}">
                                <Binding />
                                <Binding Path="DataContext.(vm:MainWindowViewModel).SelectedMapping"
                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                        </Border.IsVisible>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="14,9,12,9">
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="30,*">
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding SourceText}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="单击" Classes="gestureLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClickText}" Classes="gestureValue" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="双击" Classes="gestureLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DoubleClickText}" Classes="gestureValue" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="长按" Classes="gestureLabel" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LongPressText}" Classes="gestureValue" />
                        </Grid>
                        <ToggleButton Grid.Column="1" Classes="rowToggle" Margin="8,0,0,0"
                                      VerticalAlignment="Center" FontSize="10" Padding="8,4"
                                      Content="{Binding IsEnabled, Converter={StaticResource EnabledText}}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        <Button Grid.Column="2" Classes="ghost" Content="删除" Margin="6,0,0,0"
                                FontSize="10" Padding="8,4" Command="{Binding DeleteCommand}" />
                    </Grid>
                </Grid>
            </controls:MappingRowBorder>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- :is(Border), not Border: a bare type selector matches the exact type only, and a
             mapping row is a MappingRowBorder - a derived Border - so "Border.card" never
             reached it and the rows rendered without their card chrome at all. -->
        <Style Selector=":is(Border).card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusXl}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- A mapping row is clickable (it opens that mapping's settings), so it answers the
             pointer: the card background fades to the hover tone. The selected row's tint sits
             on top of this, so a selected row keeps its own emphasis while an unselected one
             lights up under the cursor. The fade is inlined on the element rather than set from
             this style: a Transitions setter does not reach a derived Border, so the style
             alone would leave the hover snapping on. -->
        <Style Selector=":is(Border).mappingRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <!-- The row is a tab stop, so keyboard focus rings it in the accent - the same ink
             the model's focused elements wear, so the two surfaces agree. Only the border
             brush changes: the row keeps one box in every state, so focusing it never shifts
             its content the way thickening the border would. -->
        <Style Selector=":is(Border).mappingRow:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Keyboard activation mirrors the pointer: while Enter/Space is held the row takes
             the same wash the pointer's hover gives it. The class is set from the
             code-behind, because a Border never receives the :pressed pseudo-class on its
             own - only PressedMixin controls such as Button do. -->
        <Style Selector=":is(Border).mappingRow.pressed">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The three gesture lines under a mapping row's source. The category label is
             fixed-width so the three functions align in one column, and the value trims
             rather than wraps: a row is one glance, not a paragraph. -->
        <Style Selector="TextBlock.gestureLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style Selector="TextBlock.gestureValue">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="6,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLg}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <!-- Hover and press are transitions, not instant flips: the background fades to the
                 hover tone and the whole button dims while it is held. -->
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLg}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="Button.ghost:pressed">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style Selector=":is(Button).caption">
            <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector=":is(Button).caption:pointerover">
            <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
        </Style>

        <Style Selector=":is(Button).caption:pressed">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style Selector=":is(Button).caption.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>

        <!-- The settings button is a toggle of the surface's visibility, so it carries the
             open state the same way the gesture segments do: an accent wash rather than a
             second glyph. -->
        <Style Selector=":is(Button).caption.settings:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
        </Style>

        <Style Selector="ToggleButton.rowToggle">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ToggleForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="ToggleButton.rowToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style Selector="ComboBox.enumCombo">
            <Setter Property="ItemTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                </DataTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- The gesture switcher: one segmented control where 单击 / 双击 / 长按 are equal
             peers. The selected segment carries the accent surface; a disabled one - the
             long-press while auto-repeat runs - is muted rather than hidden, so the exclusion
             stays visible instead of looking like a missing feature. -->
        <Style Selector="RadioButton.gestureSegment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CornerRadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RadioButton.gestureSegment:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="RadioButton.gestureSegment:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="RadioButton.gestureSegment:disabled">
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- The slider's own ControlTheme (Themes/Slider.axaml) sets Foreground to the accent
             and Background to the delineated track, so no per-window override is needed. -->

        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- The key cap: a keyboard key is a different kind of thing from a gamepad button,
             so the picker's options read as keys instead of a wall of same-weight rows. This
             is the cap's resting surface; the picker panel's own styles carry the selection,
             hover and focus states on top of it. -->
        <Style Selector="Border.keyCap">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
        </Style>

        <Style Selector="TextBlock.keyCapLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Height="44">
            <Border Background="{DynamicResource TitleBarBrush}"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="TitleBarPointerPressed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image x:Name="TitleBarIcon" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="DeziroJoy" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="手柄映射工具" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="ShowLeftPanelButton" Classes="ghost" Content="左栏" Width="44" Height="28" FontSize="11"
                        Padding="8,0" Margin="0,0,4,0" IsVisible="False"
                        ToolTip.Tip="显示左侧状态栏" Click="ShowLeftPanelClick" />
                <Button x:Name="ShowRightPanelButton" Classes="ghost" Content="右栏" Width="44" Height="28" FontSize="11"
                        Padding="8,0" Margin="0,0,4,0" IsVisible="False"
                        ToolTip.Tip="显示右侧映射列表" Click="ShowRightPanelClick" />
                <ToggleButton x:Name="SettingsButton" Classes="caption settings"
                              chrome:WindowDecorationProperties.ElementRole="User"
                              ToolTip.Tip="设置" IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}">
                    <!-- Gear glyph, drawn as a path so it needs no icon font and stays crisp at
                         the 16px title-bar size. Painted with the CaptionGlyphBrush token, so it
                         follows the theme like every other caption mark. -->
                    <Grid Width="16" Height="16">
                        <Path Stretch="Uniform" Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="2"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                        <Ellipse Width="6" Height="6" Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="2" />
                    </Grid>
                </ToggleButton>
                <Button x:Name="MinimizeButton" Classes="caption"
                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                        Click="MinimizeClick">
                    <Rectangle Width="10" Height="1" Fill="{DynamicResource CaptionGlyphBrush}" />
                </Button>
                <Button x:Name="MaximizeButton" Classes="caption"
                        chrome:WindowDecorationProperties.ElementRole="User"
                        ToolTip.Tip="最大化" Click="MaximizeClick">
                    <Grid Width="12" Height="12">
                        <Rectangle x:Name="MaximizeGlyph" Width="10" Height="10"
                                   Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="1" />
                        <Grid x:Name="RestoreGlyph" IsVisible="False">
                            <Rectangle Width="8" Height="8" Margin="0,0,4,4"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="1" />
                            <Rectangle Width="8" Height="8" Margin="4,4,0,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Fill="{DynamicResource TitleBarBrush}"
                                       Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton" Classes="caption close"
                        chrome:WindowDecorationProperties.ElementRole="CloseButton"
                        Click="CloseClick">
                    <Grid Width="10" Height="10">
                        <Rectangle Width="10" Height="1" Fill="{DynamicResource CaptionGlyphBrush}">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="10" Height="1" Fill="{DynamicResource CaptionGlyphBrush}">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="0" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="LeftPanel" Grid.Column="0" MinWidth="0" Padding="16,16,14,16">
                <StackPanel>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="连接" />
                            <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding HasController, Converter={StaticResource DotBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                           Margin="10,0,8,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" IsVisible="{Binding HasController}" Background="{DynamicResource SubtleBrush}"
                                        CornerRadius="{DynamicResource CornerRadiusMd}" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveController.Descriptor.Layout, Converter={StaticResource LayoutText}}"
                                               FontSize="11" Foreground="{DynamicResource BadgeTextBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="引擎" />
                            <Button x:Name="StartStopButton" Classes="primary" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Margin="0,12,0,0"
                                    Content="{Binding IsEngineRunning, Converter={StaticResource EngineStateText}}"
                                    Command="{Binding ToggleEngineCommand}" />
                            <CheckBox x:Name="PauseMappingCheckBox" Content="暂停映射" Margin="0,14,0,0"
                                      IsChecked="{Binding IsMappingEnabled, Converter={StaticResource Not}, Mode=TwoWay}"
                                      Command="{Binding ToggleMappingCommand}" />
                            <TextBlock Classes="hint" Margin="0,8,0,0"
                                       Text="暂停后仍可编辑配置，恢复后立即生效。" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" ResizeDirection="Columns"
                          Background="{DynamicResource SubtleBrush}" DragCompleted="SidebarDragCompleted" />

            <!-- The centre column: the global preset strip above the tab surface. The strip
                 is app-wide ("切换整个应用"), so it rides above the tab bar rather than inside
                 one tab, and it spans the column's full width - the wide-short cards get the
                 horizontal room the old narrow gutter beside the model never gave them. The
                 strip takes its height from the column, which leaves the mapping tab's stage
                 row untouched (the model keeps its DESIGN 4.6 sizing and responsive scaling)
                 and the editor row - the star row that absorbs slack - shorter by the same
                 amount; the editor body scrolls, as it already did at the minimum size. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:PresetSlotSelector x:Name="GlobalPresetSelector" Grid.Row="0" />

                <TabControl x:Name="MainTabs" Grid.Row="1" Margin="6,8,10,16">

                <TabItem Header="按键映射">
                    <Grid Margin="14,12,14,0">
                        <Grid.RowDefinitions>
                            <!-- The model stage is a fixed-height row: opening the editor below
                                 must not re-lay the model out, or it would jump before the lift
                                 animation even starts. The only motion is the animated lift.
                                 The stage is 420 rather than 480 (DESIGN 4.3.7): the released
                                 60px go to the editor card below, which is the surface that
                                 actually needs the room. -->
                            <RowDefinition Height="420" />
                            <RowDefinition Height="{Binding IsEditing, Converter={StaticResource EditorRowHeight}}" />
                        </Grid.RowDefinitions>

                        <!-- The model stage. No card wraps the model: it is the surface itself,
                             enlarged and centred by default. While a mapping is being edited it
                             lifts, clearing room for the card that slides in below it.

                             The stage is split so the title and the instructions own a header
                             row and the model owns the rest. The lift is a render transform,
                             so it moves the model without re-laying anything out - which also
                             means nothing but reserved space stops it from carrying the
                             shoulder buttons up over the header text. The model row therefore
                             reserves an inset equal to the lift (EditorLift, -24): at full
                             lift the model's top lands exactly on its own row's top edge, so
                             the header stays clear while the editor is open. The stage spans
                             the tab's full width now that the preset selector no longer takes
                             a gutter column beside the model. -->
                        <Grid Grid.Row="0" MaxWidth="620" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Classes="cardTitle" Text="手柄模型" HorizontalAlignment="Center" />
                                <TextBlock Classes="hint" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="点击任意按键或摇杆即可编辑它的映射；连接手柄后，按下的按键会实时高亮。" />
                            </StackPanel>
                            <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="380" MaxWidth="620"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
                                <Viewbox.RenderTransform>
                                    <TranslateTransform Y="{Binding IsEditing, Converter={StaticResource EditorLift}}">
                                        <TranslateTransform.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Y" Duration="{DynamicResource MotionDurationSlow}" Easing="{DynamicResource MotionEaseStandard}" />
                                            </Transitions>
                                        </TranslateTransform.Transitions>
                                    </TranslateTransform>
                                </Viewbox.RenderTransform>
                                <controls:GamepadVisualizer x:Name="GamepadVisualizer" DataContext="{Binding Visualizer}" />
                            </Viewbox>
                        </Grid>

                        <!-- The editor card is a FIXED frame, not a child of a scroll region:
                             only its body scrolls, so the card's border, background and rounded
                             corners stay put and the connector line's endpoint does not drift.
                             The header is pinned so 确定/取消 never scroll out of reach, which
                             matters most at the window's minimum height where the body has to
                             scroll. Its row collapses to zero when no mapping is open, handing
                             the whole height back to the model stage. The card slides up and
                             fades in as it appears, and the model lifts out of its way. -->
                        <Border Grid.Row="1" x:Name="EditorPanel" Classes="card" Margin="0,0,0,12"
                                IsVisible="{Binding IsEditing}" ClipToBounds="True"
                                Opacity="{Binding IsEditing, Converter={StaticResource EditorFade}}">
                            <Border.RenderTransform>
                                <TranslateTransform Y="{Binding IsEditing, Converter={StaticResource EditorSlide}}">
                                    <TranslateTransform.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Y" Duration="{DynamicResource MotionDurationBase}" Easing="{DynamicResource MotionEaseStandard}" />
                                        </Transitions>
                                    </TranslateTransform.Transitions>
                                </TranslateTransform>
                            </Border.RenderTransform>
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationBase}" Easing="{DynamicResource MotionEaseStandard}" />
                                </Transitions>
                            </Border.Transitions>
                            <views:MappingEditorPanel DataContext="{Binding Editor}" />
                        </Border>

                        <!-- Connector layer. Drawn last so it sits in front of the cards and the
                             line stays visible where it crosses them; non-interactive, so it never
                             steals a click. MappingLink draws it from the selected model element to
                             that element's source card. -->
                        <Canvas x:Name="ConnectorLayer" Grid.RowSpan="2" IsHitTestVisible="False" />

                        <!-- Zero-size wiring control: keeps the model, the source list and the
                             connector layer in step with the selected mapping. Measures to nothing
                             and takes no hit-testing. -->
                        <controls:MappingLink Grid.RowSpan="2" Width="0" Height="0" IsHitTestVisible="False" />
                    </Grid>
                </TabItem>

                <TabItem Header="鼠标灵敏度" DataContext="{Binding MouseSensitivity}">
                    <views:MouseSensitivityPanel />
                </TabItem>

                <TabItem Header="滚轮灵敏度" DataContext="{Binding ScrollSensitivity}">
                    <views:ScrollSensitivityPanel />
                </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" ResizeDirection="Columns"
                          Background="{DynamicResource SubtleBrush}" DragCompleted="SidebarDragCompleted" />

            <Border Grid.Column="4" x:Name="RightPanel" MinWidth="0"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleBrush}"
                    BorderThickness="1,0,0,0" Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="cardTitle" Text="按键配置" />
                        <TextBlock Classes="hint" Margin="0,4,0,0"
                                   Text="所有已配置的映射。点击任意一行即可编辑，选中行与手柄模型联动高亮。" />
                    </StackPanel>

                    <!-- The scroll content reserves a 16px gutter on the right: the vertical
                         scrollbar is an overlay that paints over the content's edge rather
                         than taking layout space, so without the gutter it would sit on top
                         of the rows' delete buttons (DESIGN 4.3.8). -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MappingsList" Margin="0,0,16,0" ItemsSource="{Binding Mappings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="MappingRowTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- The settings surface. It is a sibling of the workspace rather than a child of
             it, so it floats above the right column without taking part in the column
             sizing, and it spans only that column's width: the connection and engine state
             in the left column and the model in the centre column stay visible and live
             while it is open. Closing it hides the surface and nothing else, so an edit in
             progress is exactly where it was left. -->
        <views:SettingsPanel x:Name="SettingsPanelHost" Grid.Row="1"
                             Width="300" Margin="0,8,0,8"
                             HorizontalAlignment="Right" VerticalAlignment="Stretch"
                             IsVisible="{Binding IsSettingsOpen}" />

        <!-- WindowDecorations="None" strips the native resize border, so the window has to
             declare its own hit-test zones. Kept as the last child so it sits above the
             content; each strip is only 4-5px, and the caption buttons start 8px from the
             right edge, so no strip covers a real control. -->
        <Grid Grid.RowSpan="2">
            <Border x:Name="ResizeTop" chrome:WindowDecorationProperties.ElementRole="ResizeN"
                    Height="4" VerticalAlignment="Top" Background="Transparent" />
            <Border x:Name="ResizeBottom" chrome:WindowDecorationProperties.ElementRole="ResizeS"
                    Height="5" VerticalAlignment="Bottom" Background="Transparent" />
            <Border x:Name="ResizeLeft" chrome:WindowDecorationProperties.ElementRole="ResizeW"
                    Width="4" HorizontalAlignment="Left" Background="Transparent" />
            <Border x:Name="ResizeRight" chrome:WindowDecorationProperties.ElementRole="ResizeE"
                    Width="5" HorizontalAlignment="Right" Background="Transparent" />
            <Border x:Name="ResizeTopLeft" chrome:WindowDecorationProperties.ElementRole="ResizeNW"
                    Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
            <Border x:Name="ResizeTopRight" chrome:WindowDecorationProperties.ElementRole="ResizeNE"
                    Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
            <Border x:Name="ResizeBottomLeft" chrome:WindowDecorationProperties.ElementRole="ResizeSW"
                    Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
            <Border x:Name="ResizeBottomRight" chrome:WindowDecorationProperties.ElementRole="ResizeSE"
                    Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />

            <!-- Zero-size wiring control: feeds live gamepad/keyboard input to the mapping
                 editor. It measures to nothing and takes no hit-testing. -->
            <views:EditorInputCapture Width="0" Height="0" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
