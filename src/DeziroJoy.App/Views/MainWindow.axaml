<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
        xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
        xmlns:controls="clr-namespace:DeziroJoy.App.Views.Controls"
        xmlns:views="clr-namespace:DeziroJoy.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="DeziroJoy.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DeziroJoy"
        Width="1320" Height="880"
        MinWidth="1180" MinHeight="780"
         WindowStartupLocation="CenterScreen"
         WindowDecorations="None"
         ExtendClientAreaToDecorationsHint="True"
         ExtendClientAreaTitleBarHeightHint="44"
         Opened="OnWindowOpened"
         Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="DotBrush" PressedKey="ConnectedBrush" IdleKey="IdleDotBrush" />
        <conv:BoolToTextConverter x:Key="EngineStateText" TrueText="停止映射" FalseText="启动映射" />
        <conv:BoolToTextConverter x:Key="EnabledText" TrueText="已启用" FalseText="已禁用" />
        <conv:BoolNegationConverter x:Key="Not" />
        <conv:LayoutToTextConverter x:Key="LayoutText" />
        <conv:TargetKindMatchConverter x:Key="KindMatch" />
        <conv:EnumDisplayConverter x:Key="EnumDisplay" />
        <conv:ScrollRateBarConverter x:Key="RateBar" />
        <conv:BoolToBrushConverter x:Key="TransferMessageBrush" PressedKey="DangerBrush" IdleKey="HintTextBrush" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.caption:pointerover">
            <Setter Property="Background" Value="{DynamicResource CaptionHoverBrush}" />
        </Style>

        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style Selector="ToggleButton.rowToggle">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ToggleForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="ToggleButton.rowToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style Selector="ComboBox.enumCombo">
            <Setter Property="ItemTemplate">
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                </DataTemplate>
            </Setter>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Height="44" Background="{DynamicResource TitleBarBrush}"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image x:Name="TitleBarIcon" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="DeziroJoy" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="手柄映射工具" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinimizeButton" Classes="caption"
                            chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                            Click="MinimizeClick">
                        <Rectangle Width="10" Height="1" Fill="{DynamicResource CaptionGlyphBrush}" />
                    </Button>
                    <Button x:Name="CloseButton" Classes="caption close"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton"
                            Click="CloseClick">
                        <Grid Width="10" Height="10">
                            <Rectangle Width="10" Height="1" Fill="{DynamicResource CaptionGlyphBrush}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="10" Height="1" Fill="{DynamicResource CaptionGlyphBrush}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="290,*,350">

            <ScrollViewer x:Name="LeftPanel" Grid.Column="0" Padding="16,16,14,16">
                <StackPanel>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="连接" />
                            <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding HasController, Converter={StaticResource DotBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                           Margin="10,0,8,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" IsVisible="{Binding HasController}" Background="{DynamicResource SubtleBrush}"
                                        CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveController.Descriptor.Layout, Converter={StaticResource LayoutText}}"
                                               FontSize="11" Foreground="{DynamicResource BadgeTextBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="引擎" />
                            <Button x:Name="StartStopButton" Classes="primary" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" Margin="0,12,0,0"
                                    Content="{Binding IsEngineRunning, Converter={StaticResource EngineStateText}}"
                                    Command="{Binding ToggleEngineCommand}" />
                            <CheckBox x:Name="PauseMappingCheckBox" Content="暂停映射" Margin="0,14,0,0"
                                      IsChecked="{Binding IsMappingEnabled, Converter={StaticResource Not}, Mode=TwoWay}"
                                      Command="{Binding ToggleMappingCommand}" />
                            <TextBlock Classes="hint" Margin="0,8,0,0"
                                       Text="暂停后仍可编辑配置，恢复后立即生效。" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="配置文件" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="SaveProfileButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="保存配置" Command="{Binding SaveProfileCommand}" />
                                <Button x:Name="ResetToDefaultButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="恢复默认" Command="{Binding ResetToDefaultCommand}" />
                                <Button x:Name="ExportProfileButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="导出配置" Command="{Binding ExportProfileCommand}" />
                                <Button x:Name="ImportProfileButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="导入配置" Command="{Binding ImportProfileCommand}" />
                            </WrapPanel>
                            <TextBlock Classes="hint" Margin="0,2,0,0"
                                       Text="配置按设备保存，重连后自动恢复。导入/导出为单个 JSON 文件，可在不同电脑间搬运。" />
                            <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding HasTransferMessage}"
                                       Foreground="{Binding IsTransferError, Converter={StaticResource TransferMessageBrush}}"
                                       Text="{Binding TransferMessage}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

                <TabControl x:Name="MainTabs" Grid.Column="1" Margin="6,8,10,16">

                <TabItem Header="按键映射">
                    <Grid Margin="14,12,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The model is the editor: it leads the tab, and every element on it
                             opens the mapping settings for that element. -->
                        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Classes="cardTitle" Text="手柄模型" />
                                <TextBlock Classes="hint" Margin="0,4,0,0"
                                           Text="点击任意按键或摇杆即可编辑它的映射；连接手柄后，按下的按键会实时高亮。" />
                                <Viewbox Stretch="Uniform" MaxHeight="300" MaxWidth="460" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <controls:GamepadVisualizer x:Name="GamepadVisualizer" DataContext="{Binding Visualizer}" />
                                </Viewbox>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl x:Name="MappingsList" ItemsSource="{Binding Mappings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MappingRowViewModel">
                                        <Border Classes="card" Padding="14,10" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceText}" FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                     <TextBlock Text="{Binding TargetText}" FontSize="11"
                                                                Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1" Classes="rowToggle" Margin="10,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding IsEnabled, Converter={StaticResource EnabledText}}"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                <Button Grid.Column="2" Classes="ghost" Content="编辑" Margin="8,0,0,0"
                                                        Command="{Binding EditCommand}" />
                                                <Button Grid.Column="3" Classes="ghost" Content="删除" Margin="8,0,0,0"
                                                        Command="{Binding DeleteCommand}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Inline companion to the model: it sits under the model rather than
                             over it, so the element being edited stays visible while its target
                             is chosen. Esc cancels, Enter confirms. -->
                        <ScrollViewer Grid.Row="2" MaxHeight="460" VerticalScrollBarVisibility="Auto">
                            <Border x:Name="EditorPanel" Classes="card" IsVisible="{Binding IsEditing}">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Classes="cardTitle" Text="编辑映射" />
                                            <TextBlock Text="{Binding Editor.SourceDescription}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Editor.TargetDescription}" FontSize="12"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="CommitButton" Classes="primary" Content="确定 (Enter)"
                                                    Command="{Binding CommitEditorCommand}" />
                                            <Button x:Name="CancelButton" Classes="ghost" Content="取消 (Esc)"
                                                    Margin="8,0,0,0" Command="{Binding CancelEditorCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Classes="sectionLabel" Text="目标动作" />
                                    <WrapPanel>
                                        <StackPanel Width="190" Margin="0,0,12,0">
                                            <TextBlock Classes="fieldLabel" Text="类型" />
                                            <ComboBox x:Name="TargetKindCombo" Classes="enumCombo"
                                                      ItemsSource="{Binding Editor.AvailableTargetKinds}"
                                                      SelectedItem="{Binding Editor.TargetKind, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel x:Name="MouseTargetRow" Width="190"
                                                    IsVisible="{Binding Editor.TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=MouseButton}">
                                            <TextBlock Classes="fieldLabel" Text="鼠标按键" />
                                            <ComboBox x:Name="MouseButtonCombo" Classes="enumCombo"
                                                      ItemsSource="{x:Static views:EnumOptions.MouseButtons}"
                                                      SelectedItem="{Binding Editor.SelectedMouseButton, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom" IsVisible="{Binding Editor.ShowButtonPicker}">
                                            <TextBlock Classes="fieldLabel" Text="键盘直接输入" />
                                            <Button x:Name="CaptureKeyButton" Classes="ghost"
                                                    Content="{Binding Editor.CaptureKeyLabel}"
                                                    Command="{Binding Editor.ToggleCaptureKeyCommand}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Classes="hint" Margin="0,8,0,0" IsVisible="{Binding Editor.IsCapturingKey}"
                                               Text="正在捕获键盘：按下目标按键（可含 Ctrl/Shift/Alt/Win 组合），全部松开即完成。" />

                                    <TextBlock Classes="sectionLabel" Text="或从列表选择"
                                                IsVisible="{Binding Editor.TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyPress|KeyCombo}" />
                                    <ListBox x:Name="TargetKeyList" MaxHeight="180"
                                             IsVisible="{Binding Editor.TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyPress|KeyCombo}"
                                             ItemsSource="{Binding Editor.KeyOptions}"
                                             SelectedItem="{Binding Editor.SelectedKeyOption, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KeyPickerItem">
                                                <Panel>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,6,0,2" IsVisible="{Binding IsHeader}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                               Foreground="{DynamicResource ControlForegroundBrush}"
                                                               IsVisible="{Binding IsHeader, Converter={StaticResource Not}}" />
                                                </Panel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="ModifierRow" Orientation="Horizontal" Margin="0,10,0,0"
                                                IsVisible="{Binding Editor.TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=KeyCombo}">
                                        <CheckBox x:Name="ModifierCtrlBox" Content="Ctrl" IsChecked="{Binding Editor.ModifierCtrl, Mode=TwoWay}" />
                                        <CheckBox x:Name="ModifierShiftBox" Content="Shift" Margin="14,0,0,0" IsChecked="{Binding Editor.ModifierShift, Mode=TwoWay}" />
                                        <CheckBox x:Name="ModifierAltBox" Content="Alt" Margin="14,0,0,0" IsChecked="{Binding Editor.ModifierAlt, Mode=TwoWay}" />
                                        <CheckBox x:Name="ModifierWinBox" Content="Win" Margin="14,0,0,0" IsChecked="{Binding Editor.ModifierWin, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel x:Name="MouseMoveRow" IsVisible="{Binding Editor.TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=MouseMove}">
                                        <TextBlock Classes="sectionLabel" Text="鼠标移动参数" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="最高速度 (px/s)" VerticalAlignment="Center" Margin="0" />
                                            <Slider Grid.Column="1" x:Name="EditorMouseMaxSpeedBox" Minimum="100" Maximum="6000" TickFrequency="50"
                                                    Value="{Binding Editor.MouseSettings.MaxSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Editor.MouseSettings.MaxSpeed, StringFormat='{}{0:F0}'}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                                            <Slider Grid.Column="1" x:Name="EditorMouseDeadZoneBox" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                                    Value="{Binding Editor.MouseSettings.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Editor.MouseSettings.DeadZone, StringFormat='{}{0:F2}'}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="平滑时间 (s)" VerticalAlignment="Center" Margin="0" />
                                            <Slider Grid.Column="1" x:Name="EditorMouseResponseTimeBox" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                                                    Value="{Binding Editor.MouseSettings.ResponseTime, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Editor.MouseSettings.ResponseTime, StringFormat='{}{0:F2}'}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="WheelRow" IsVisible="{Binding Editor.TargetKind, Converter={StaticResource KindMatch}, ConverterParameter=WheelScroll}">
                                        <TextBlock Classes="sectionLabel" Text="滚轮参数" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="滚动速率 (格/s)" VerticalAlignment="Center" Margin="0" />
                                            <Slider Grid.Column="1" x:Name="EditorScrollRateBox" Minimum="1" Maximum="40" TickFrequency="1"
                                                    Value="{Binding Editor.ScrollSettings.MaxTicksPerSecond, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Editor.ScrollSettings.MaxTicksPerSecond, StringFormat='{}{0:F0}'}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                                            <Slider Grid.Column="1" x:Name="EditorScrollDeadzoneBox" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                                    Value="{Binding Editor.ScrollSettings.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Editor.ScrollSettings.DeadZone, StringFormat='{}{0:F2}'}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="鼠标灵敏度">
                    <ScrollViewer>
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="520" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="cardTitle" Text="摇杆 → 鼠标" Margin="0,0,0,10" />
                                <TextBlock x:Name="PhysicalUnitHint" Classes="hint" Margin="0,0,0,16"
                                           Text="{Binding MouseSensitivity.PhysicalUnitHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="最高速度" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="MaxSpeedSlider" Minimum="100" Maximum="6000" TickFrequency="50"
                                            Value="{Binding MouseSensitivity.MaxSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.MaxSpeed, StringFormat='{}{0:F0} px/s'}" />
                                </Grid>
                                <TextBlock x:Name="MaxSpeedHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding MouseSensitivity.MaxSpeedHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="DeadZoneSlider" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                            Value="{Binding MouseSensitivity.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.DeadZone, StringFormat='{}{0:F2}'}" />
                                </Grid>
                                <TextBlock x:Name="DeadZoneHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding MouseSensitivity.DeadZoneHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="响应曲线" VerticalAlignment="Center" Margin="0" />
                                    <ComboBox Grid.Column="1" x:Name="CurveComboBox" Classes="enumCombo" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static views:EnumOptions.Curves}"
                                              SelectedItem="{Binding MouseSensitivity.Curve, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock x:Name="CurveHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding MouseSensitivity.CurveHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="曲线强度" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="CurveStrengthSlider" Minimum="0" Maximum="2" TickFrequency="0.1"
                                            Value="{Binding MouseSensitivity.CurveStrength, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.CurveStrength, StringFormat='{}{0:F2}'}" />
                                </Grid>
                                <TextBlock x:Name="CurveStrengthHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding MouseSensitivity.CurveStrengthHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="平滑时间" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="ResponseTimeSlider" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                                            Value="{Binding MouseSensitivity.ResponseTime, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.ResponseTime, StringFormat='{}{0:F2} s'}" />
                                </Grid>
                                <TextBlock x:Name="ResponseTimeHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding MouseSensitivity.ResponseTimeHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="精准模式倍率" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="PrecisionScaleSlider" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                                            Value="{Binding MouseSensitivity.PrecisionScale, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.PrecisionScale, StringFormat='{}{0:F2}'}" />
                                </Grid>
                                <TextBlock x:Name="PrecisionScaleHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding MouseSensitivity.PrecisionScaleHint}" />

                                <CheckBox x:Name="InvertYBox" Content="垂直反转" IsChecked="{Binding MouseSensitivity.InvertY, Mode=TwoWay}" />
                                <TextBlock x:Name="InvertYHint" Classes="hint" Margin="0,4,0,0"
                                           Text="{Binding MouseSensitivity.InvertYHint}" />

                                <Button Classes="primary" Content="应用" HorizontalAlignment="Left" Margin="0,18,0,0"
                                        Command="{Binding ApplyMouseSensitivityCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Top">
                                <TextBlock Classes="cardTitle" Text="实时预览" Margin="0,0,0,12" />
                                <controls:SensitivityPreview x:Name="MousePreviewHost" DataContext="{Binding MouseSensitivity}" />

                                <Grid Margin="0,16,0,0" Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="当前速度" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.CurrentSpeed, StringFormat='{}{0:F0} px/s'}" />
                                </Grid>
                                <Grid Margin="0,6,0,0" Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="累计位移" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                               Text="{Binding MouseSensitivity.TravelDistance, StringFormat='{}{0:F0} px'}" />
                                </Grid>

                                <TextBlock Classes="cardTitle" Text="响应曲线" Margin="0,22,0,12" />
                                <controls:ResponseCurveGraph x:Name="CurveGraphHost" DataContext="{Binding MouseSensitivity}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="滚轮灵敏度">
                    <ScrollViewer>
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="520" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="cardTitle" Text="摇杆 → 滚轮" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="滚动速率" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="ScrollRateSlider" Minimum="1" Maximum="40" TickFrequency="1"
                                            Value="{Binding ScrollSensitivity.MaxTicksPerSecond, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ScrollSensitivity.MaxTicksPerSecond, StringFormat='{}{0:F0} 格/s'}" />
                                </Grid>
                                <TextBlock x:Name="ScrollRateHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding ScrollSensitivity.RateHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="ScrollDeadzoneSlider" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                                            Value="{Binding ScrollSensitivity.DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ScrollSensitivity.DeadZone, StringFormat='{}{0:F2}'}" />
                                </Grid>
                                <TextBlock x:Name="ScrollDeadzoneHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding ScrollSensitivity.DeadZoneHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="响应曲线" VerticalAlignment="Center" Margin="0" />
                                    <ComboBox Grid.Column="1" x:Name="ScrollCurveCombo" Classes="enumCombo" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Static views:EnumOptions.Curves}"
                                              SelectedItem="{Binding ScrollSensitivity.Curve, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock x:Name="ScrollCurveHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding ScrollSensitivity.CurveHint}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="平滑时间" VerticalAlignment="Center" Margin="0" />
                                    <Slider Grid.Column="1" x:Name="ScrollResponseTimeSlider" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                                            Value="{Binding ScrollSensitivity.ResponseTime, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding ScrollSensitivity.ResponseTime, StringFormat='{}{0:F2} s'}" />
                                </Grid>
                                <TextBlock x:Name="ScrollResponseTimeHint" Classes="hint" Margin="150,0,0,14"
                                           Text="{Binding ScrollSensitivity.ResponseTimeHint}" />

                                <CheckBox x:Name="EnableHorizontalBox" Content="启用水平滚动"
                                          IsChecked="{Binding ScrollSensitivity.EnableHorizontal, Mode=TwoWay}" />
                                <TextBlock x:Name="ScrollEnableHorizontalHint" Classes="hint" Margin="0,4,0,0"
                                           Text="{Binding ScrollSensitivity.EnableHorizontalHint}" />
                                <CheckBox x:Name="ScrollInvertYBox" Content="垂直反转" Margin="0,8,0,0"
                                          IsChecked="{Binding ScrollSensitivity.InvertY, Mode=TwoWay}" />
                                <TextBlock x:Name="ScrollInvertYHint" Classes="hint" Margin="0,4,0,0"
                                           Text="{Binding ScrollSensitivity.InvertYHint}" />

                                <Button Classes="primary" Content="应用" HorizontalAlignment="Left" Margin="0,18,0,0"
                                        Command="{Binding ApplyScrollSensitivityCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Top">
                                <TextBlock Classes="cardTitle" Text="实时预览" Margin="0,0,0,12" />

                                <Border x:Name="ScrollPreviewHost" Width="200" Height="200" Background="{DynamicResource SunkenBrush}"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Rectangle Width="6" Height="140" RadiusX="3" RadiusY="3" Fill="{DynamicResource TrackBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Rectangle x:Name="ScrollRateBar" Width="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35">
                                            <Rectangle.Height>
                                                <MultiBinding Converter="{StaticResource RateBar}">
                                                    <Binding Path="ScrollSensitivity.CurrentRate" />
                                                    <Binding Path="ScrollSensitivity.MaxTicksPerSecond" />
                                                </MultiBinding>
                                            </Rectangle.Height>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0" Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="滚轮偏移" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                               Text="{Binding ScrollSensitivity.WheelOffset, StringFormat='{}{0:F1}'}" />
                                </Grid>
                                <Grid Margin="0,6,0,0" Width="200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="当前速率" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                               Text="{Binding ScrollSensitivity.CurrentRate, StringFormat='{}{0:F1} 格/s'}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Feedback column: always visible, never coupled to the tab. The interactive
                 model lives in the mapping tab, so this column carries the live readout that
                 used to sit under it. -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleBrush}" BorderThickness="1,0,0,0"
                    Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="cardTitle" Text="手柄状态" Margin="0,0,0,14" />
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                         Fill="{Binding HasController, Converter={StaticResource DotBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                           Margin="10,0,8,0" VerticalAlignment="Center" />
                                <Border Grid.Column="2" IsVisible="{Binding HasController}" Background="{DynamicResource SubtleBrush}"
                                        CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveController.Descriptor.Layout, Converter={StaticResource LayoutText}}"
                                               FontSize="11" Foreground="{DynamicResource BadgeTextBrush}" />
                                </Border>
                            </Grid>

                            <TextBlock Classes="sectionLabel" Text="摇杆" Margin="0,4,0,6" />
                            <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="左 X/Y" Width="52" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                           Text="{Binding Visualizer.LeftStickX, StringFormat='{}{0:F2}'}" />
                            </Grid>
                            <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="左 Y" Width="52" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                           Text="{Binding Visualizer.LeftStickY, StringFormat='{}{0:F2}'}" />
                            </Grid>
                            <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="右 X" Width="52" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                           Text="{Binding Visualizer.RightStickX, StringFormat='{}{0:F2}'}" />
                            </Grid>
                            <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="右 Y" Width="52" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                           Text="{Binding Visualizer.RightStickY, StringFormat='{}{0:F2}'}" />
                            </Grid>

                            <TextBlock Classes="sectionLabel" Text="按下的按键" Margin="0,10,0,6" />
                            <WrapPanel>
                                <Border IsVisible="{Binding Visualizer.IsAPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="A" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsBPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="B" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsXPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="X" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsYPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="Y" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsLeftBumperPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="LB" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsRightBumperPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="RB" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsLeftTriggerPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="LT" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsRightTriggerPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="RT" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsDPadUpPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="↑" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsDPadDownPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="↓" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsDPadLeftPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="←" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsDPadRightPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsLeftStickPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="左摇杆" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsRightStickPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="右摇杆" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsBackPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="Back" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsStartPressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="Start" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border IsVisible="{Binding Visualizer.IsGuidePressed}" Background="{DynamicResource AccentSurfaceBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                    <TextBlock Text="Guide" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Classes="hint" Margin="0,14,0,0"
                                       Text="在“按键映射”标签页中点击手柄模型上的任意元素，即可编辑它的映射。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- WindowDecorations="None" strips the native resize border, so the window has to
             declare its own hit-test zones. Kept as the last child so it sits above the
             content; each strip is only 4-5px, and the caption buttons start 8px from the
             right edge, so no strip covers a real control. -->
        <Grid Grid.RowSpan="2">
            <Border x:Name="ResizeTop" chrome:WindowDecorationProperties.ElementRole="ResizeN"
                    Height="4" VerticalAlignment="Top" Background="Transparent" />
            <Border x:Name="ResizeBottom" chrome:WindowDecorationProperties.ElementRole="ResizeS"
                    Height="5" VerticalAlignment="Bottom" Background="Transparent" />
            <Border x:Name="ResizeLeft" chrome:WindowDecorationProperties.ElementRole="ResizeW"
                    Width="4" HorizontalAlignment="Left" Background="Transparent" />
            <Border x:Name="ResizeRight" chrome:WindowDecorationProperties.ElementRole="ResizeE"
                    Width="5" HorizontalAlignment="Right" Background="Transparent" />
            <Border x:Name="ResizeTopLeft" chrome:WindowDecorationProperties.ElementRole="ResizeNW"
                    Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
            <Border x:Name="ResizeTopRight" chrome:WindowDecorationProperties.ElementRole="ResizeNE"
                    Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" />
            <Border x:Name="ResizeBottomLeft" chrome:WindowDecorationProperties.ElementRole="ResizeSW"
                    Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" />
            <Border x:Name="ResizeBottomRight" chrome:WindowDecorationProperties.ElementRole="ResizeSE"
                    Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" />

            <!-- Zero-size wiring control: feeds live gamepad/keyboard input to the mapping
                 editor. It measures to nothing and takes no hit-testing. -->
            <views:EditorInputCapture Width="0" Height="0" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
