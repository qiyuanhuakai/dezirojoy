<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             xmlns:controls="clr-namespace:DeziroJoy.App.Views.Controls"
             x:Class="DeziroJoy.App.Views.SettingsPanel"
             x:DataType="vm:MainWindowViewModel">

    <!--
        The settings surface. It is an overlay beside the workspace, not a replacement
        for it: the connection and engine state in the left column and the model in the
        centre column stay visible and live while this is open, so the panel only ever
        covers the space the settings cards themselves used to occupy.

        Every control here binds to the window's own view models - the profile commands,
        the shared AppearanceViewModel and the resident DaemonSettingsViewModel - so the
        surface is a view over the running state rather than a second copy of it.
    -->

    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="Not" />
        <conv:BoolToBrushConverter x:Key="TransferMessageBrush" PressedKey="DangerBrush" IdleKey="HintTextBrush" />
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusXl}"
            Padding="12">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="cardTitle" Text="设置" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="CloseSettingsButton" Classes="ghost" Content="关闭"
                        FontSize="11" Padding="10,4" Command="{Binding CloseSettingsCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="配置文件" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="SaveProfileButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="保存配置" Command="{Binding SaveProfileCommand}" />
                                <Button x:Name="ResetToDefaultButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="恢复默认" Command="{Binding ResetToDefaultCommand}" />
                                <Button x:Name="ExportSchemeButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="导出方案" Command="{Binding ExportSchemeCommand}" />
                                <Button x:Name="ImportSchemeButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="导入方案" Command="{Binding ImportSchemeCommand}" />
                                <Button x:Name="ImportWindowsTemplateButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="导入 Windows 内置模板"
                                        Command="{Binding ImportWindowsTemplateCommand}" />
                            </WrapPanel>
                            <TextBlock Classes="hint" Margin="0,2,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding HasTransferMessage}"
                                       Foreground="{Binding IsTransferError, Converter={StaticResource TransferMessageBrush}}"
                                       Text="{Binding TransferMessage}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="外观" />
                            <StackPanel Margin="0,12,0,0">
                                <RadioButton Content="浅色" IsChecked="{Binding Appearance.IsLight, Mode=TwoWay}" />
                                <RadioButton Content="深色" IsChecked="{Binding Appearance.IsLight, Converter={StaticResource Not}, Mode=TwoWay}" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        The update surface. The running version comes from the assembly, the
                        whole check/download/install/restart flow lives in the
                        UpdateSettingsViewModel over the update orchestrator, and the two
                        platform actions a view model deliberately does not perform - opening
                        the release page and exiting the process for a restart - are raised as
                        events the code-behind answers, the same "view model raises, view
                        answers" pattern the profile import/export dialogs use.
                    -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="更新" />
                            <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Classes="fieldLabel" Text="当前版本" />
                                <TextBlock Grid.Column="1" Classes="fieldLabel" Margin="12,0,0,0"
                                           Text="{Binding Update.CurrentVersionText}" />
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="CheckUpdateButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="检查更新" Command="{Binding Update.CheckForUpdateCommand}"
                                        IsEnabled="{Binding Update.IsBusy, Converter={StaticResource Not}}" />
                                <Button x:Name="DownloadUpdateButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="下载更新" IsVisible="{Binding Update.CanDownload}"
                                        Command="{Binding Update.DownloadUpdateCommand}" />
                                <Button x:Name="CancelUpdateButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="取消" IsVisible="{Binding Update.CanCancelDownload}"
                                        Command="{Binding Update.CancelUpdateCommand}" />
                                <Button x:Name="InstallUpdateButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="立即安装并重启" IsVisible="{Binding Update.CanInstall}"
                                        IsEnabled="{Binding Update.IsBusy, Converter={StaticResource Not}}"
                                        Command="{Binding Update.InstallUpdateCommand}" />
                                <Button x:Name="OpenReleasePageButton" Classes="ghost" Margin="0,0,8,8"
                                        Content="前往下载" IsVisible="{Binding Update.HasUpdate}"
                                        Command="{Binding Update.OpenReleasePageCommand}" />
                            </WrapPanel>
                            <ProgressBar x:Name="UpdateDownloadProgressBar" Margin="0,10,0,0"
                                         IsVisible="{Binding Update.IsDownloading}"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding Update.DownloadProgress}" />
                            <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding Update.CanInstall}"
                                       Text="安装会先停止守护进程与托盘，完成后自动重启应用；更新包已经 SHA256 校验，未经代码签名。" />
                            <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding Update.HasResult}"
                                       Foreground="{Binding Update.IsResultError, Converter={StaticResource TransferMessageBrush}}"
                                       Text="{Binding Update.ResultText}" />
                            <TextBlock x:Name="UpdateInstallGuidanceText" Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                                       IsVisible="{Binding Update.HasInstallGuidance}"
                                       Text="{Binding Update.InstallGuidance}" />
                            <CheckBox x:Name="AutoCheckUpdatesBox" Content="启动时自动检查" Margin="0,12,0,0"
                                      IsChecked="{Binding Update.AutoCheckEnabled, Mode=TwoWay}" />
                            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="开启后每次启动应用时自动检查一次新版本；仅检查，不会自动下载或安装更新。" />
                            <CheckBox x:Name="AutoDownloadUpdatesBox" Content="发现新版本后自动下载" Margin="0,12,0,0"
                                      IsChecked="{Binding Update.AutoDownloadEnabled, Mode=TwoWay}" />
                            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="开启后检查到新版本会自动下载并校验；安装更新仍需一次点击，不会自动安装或重启。" />
                        </StackPanel>
                    </Border>

                    <!--
                        The temporary layer hint overlay. 显示临时层提示 is the manual dismissal:
                        the overlay is click-through, so it cannot host a close button without
                        risking a focus or click steal from the target application - the exact
                        thing it exists to avoid - and the close therefore lives here instead.
                        The two placement modes (a fixed screen edge/corner, or beside the
                        pointer) and the fixed anchor ride the persisted preferences, which the
                        tray reads too, so a window dismissal carries into tray-only mode.
                    -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="临时层提示" />
                            <CheckBox x:Name="ShowLayerHintBox" Content="显示临时层提示" Margin="0,12,0,0"
                                      IsChecked="{Binding ShowLayerHint, Mode=TwoWay}" />
                            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="按住临时层 Leader 键时，在屏幕上浮出该层每个按键的作用。关闭后即使按住 Leader 也不再显示；浮层为点击穿透、无法直接在上面点击关闭，故在此开关。" />
                            <TextBlock Classes="fieldLabel" Margin="0,14,0,0" Text="浮层位置" />
                            <StackPanel Margin="0,6,0,0">
                                <RadioButton Content="固定位置" IsChecked="{Binding IsOverlayFollowMouse, Converter={StaticResource Not}, Mode=TwoWay}" />
                                <RadioButton Content="跟随鼠标" Margin="0,8,0,0" IsChecked="{Binding IsOverlayFollowMouse, Mode=TwoWay}" />
                            </StackPanel>
                            <ComboBox x:Name="OverlayAnchorCombo" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                      IsVisible="{Binding IsOverlayFollowMouse, Converter={StaticResource Not}}"
                                      SelectedIndex="{Binding OverlayAnchorIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="底部居中" />
                                <ComboBoxItem Content="底部左对齐" />
                                <ComboBoxItem Content="底部右对齐" />
                                <ComboBoxItem Content="顶部居中" />
                                <ComboBoxItem Content="顶部左对齐" />
                                <ComboBoxItem Content="顶部右对齐" />
                                <ComboBoxItem Content="左侧居中" />
                                <ComboBoxItem Content="右侧居中" />
                            </ComboBox>
                            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="固定位置停靠在所选屏幕边缘或角落；跟随鼠标在按住 Leader 时出现在指针旁（需可读取指针位置，纯 Wayland 会话下回退为固定位置）。" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="后台与托盘" />
                            <CheckBox x:Name="CloseToTrayBox" Content="关闭后退出到托盘" Margin="0,12,0,0"
                                      IsChecked="{Binding CloseToTrayEnabled, Mode=TwoWay}" />
                            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="开启时关闭窗口并交接托盘，daemon 继续映射；关闭时完整退出 GUI、托盘与 daemon。普通最小化仍由下方选项决定。" />
                            <CheckBox x:Name="MinimizeToTrayBox" Content="最小化后退出到托盘" Margin="0,12,0,0"
                                      IsChecked="{Binding MinimizeToTrayEnabled, Mode=TwoWay}" />
                            <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="开启时最小化会销毁窗口与渲染资源并交接托盘；关闭时保留 GUI 进程，仅执行普通最小化。" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="cardTitle" Text="注入状态" />
                            <TextBlock Classes="fieldLabel" Margin="0,10,0,0"
                                       Text="{Binding InjectorDescription}" />
                            <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding MappingOwnerDescription}" />
                            <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding InjectorStatusText}" />
                            <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding DaemonStatusText}" />
                            <Button Classes="ghost" Margin="0,10,0,0" Padding="10,4"
                                    Content="重新连接守护" IsVisible="{Binding IsDaemonMode}"
                                    Command="{Binding ReconnectDaemonCommand}" />

                            <Grid Margin="0,10,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  IsVisible="{Binding IsDaemonMode}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="hint" Text="权限" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="hint" Margin="12,0,0,0"
                                           x:Name="InjectorIntegrityText" Text="{Binding DaemonSnapshot.InjectorIntegrity}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="hint" Margin="0,6,0,0" Text="修订" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" Margin="12,6,0,0"
                                           x:Name="DaemonRevisionText" Text="{Binding DaemonSnapshot.Revision}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="hint" Margin="0,6,0,0" Text="已注入" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" Margin="12,6,0,0"
                                           x:Name="InjectedEventsText" Text="{Binding DaemonSnapshot.InjectedEvents}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="hint" Margin="0,6,0,0" Text="已阻止" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="hint" Margin="12,6,0,0"
                                           x:Name="BlockedEventsText" Text="{Binding DaemonSnapshot.BlockedEvents}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="hint" Margin="0,6,0,0" Text="错误" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Classes="hint" Margin="12,6,0,0" TextWrapping="Wrap"
                                           x:Name="DaemonLastErrorText" Text="{Binding DaemonSnapshot.LastError}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <controls:DaemonSettingsCard DataContext="{Binding DaemonSettings}" />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
