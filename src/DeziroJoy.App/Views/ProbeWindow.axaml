<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
        x:Class="DeziroJoy.App.Views.ProbeWindow"
        x:DataType="vm:MouseSensitivityViewModel"
        Title="Probe">
    <Slider x:Name="ProbeSlider" Minimum="100" Maximum="6000" Value="{Binding MaxSpeed, Mode=TwoWay}" />
</Window>
