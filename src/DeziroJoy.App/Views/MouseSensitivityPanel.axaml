<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:controls="clr-namespace:DeziroJoy.App.Views.Controls"
             xmlns:views="clr-namespace:DeziroJoy.App.Views"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             x:Class="DeziroJoy.App.Views.MouseSensitivityPanel"
             x:DataType="vm:MouseSensitivityViewModel">

    <!--
        The 鼠标灵敏度 tab's content: the stick-to-mouse calibration sliders on the left and
        the live preview (dot sweep, speed/travel readouts, response-curve graph) on the right.
        The panel is a view over one MouseSensitivityViewModel - the host binds it as
        DataContext="{Binding MouseSensitivity}" - so every path here is relative to that view
        model, and the preview controls inherit it rather than rebinding it.

        The preview column also carries the input-source switch: the synthetic sweep by
        default, or real host samples that expose the raw stick, the deadzone-filtered
        deflection and the final speed, plus the at-rest drift measurement that suggests a
        confirmable deadzone.

        The 应用 button writes the settings into the active profile, which is the window's
        orchestration, so its command reaches the window's view model through the Window
        ancestor.
    -->

    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="Not" />
    </UserControl.Resources>

    <ScrollViewer>
        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="640" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Classes="cardTitle" Text="摇杆 → 鼠标" Margin="0,0,0,10" />
                <TextBlock x:Name="PhysicalUnitHint" Classes="hint" Margin="0,0,0,16"
                           Text="{Binding PhysicalUnitHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="最高速度" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="MaxSpeedSlider" Minimum="100" Maximum="6000" TickFrequency="50"
                            Value="{Binding MaxSpeed, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding MaxSpeed, StringFormat='{}{0:F0} px/s'}" />
                </Grid>
                <TextBlock x:Name="MaxSpeedHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding MaxSpeedHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="DeadZoneSlider" Minimum="0" Maximum="0.6" TickFrequency="0.05"
                            Value="{Binding DeadZone, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding DeadZone, StringFormat='{}{0:F2}'}" />
                </Grid>
                <TextBlock x:Name="DeadZoneHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding DeadZoneHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="响应曲线" VerticalAlignment="Center" Margin="0" />
                    <ComboBox Grid.Column="1" x:Name="CurveComboBox" Classes="enumCombo" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Static views:EnumOptions.Curves}"
                              SelectedItem="{Binding Curve, Mode=TwoWay}" />
                </Grid>
                <TextBlock x:Name="CurveHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding CurveHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="曲线强度" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="CurveStrengthSlider" Minimum="0" Maximum="1" TickFrequency="0.1"
                            Value="{Binding CurveStrength, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding CurveStrength, StringFormat='{}{0:F2}'}" />
                </Grid>
                <TextBlock x:Name="CurveStrengthHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding CurveStrengthHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="平滑时间" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="ResponseTimeSlider" Minimum="0" Maximum="0.5" TickFrequency="0.05"
                            Value="{Binding ResponseTime, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ResponseTime, StringFormat='{}{0:F2} s'}" />
                </Grid>
                <TextBlock x:Name="ResponseTimeHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding ResponseTimeHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="水平增益" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="ScaleXSlider" Minimum="0" Maximum="4" TickFrequency="0.1"
                            Value="{Binding ScaleX, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ScaleX, StringFormat='{}{0:F2}×'}" />
                </Grid>
                <TextBlock x:Name="ScaleXHint" Classes="hint" Margin="150,0,0,14"
                           Text="1 为原始速度，0 关闭左右移动" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="垂直增益" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="ScaleYSlider" Minimum="0" Maximum="4" TickFrequency="0.1"
                            Value="{Binding ScaleY, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding ScaleY, StringFormat='{}{0:F2}×'}" />
                </Grid>
                <TextBlock x:Name="ScaleYHint" Classes="hint" Margin="150,0,0,14"
                           Text="1 为原始速度，0 关闭上下移动" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="精准模式倍率" VerticalAlignment="Center" Margin="0" />
                    <Slider Grid.Column="1" x:Name="PrecisionScaleSlider" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                            Value="{Binding PrecisionScale, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding PrecisionScale, StringFormat='{}{0:F2}'}" />
                </Grid>
                <TextBlock x:Name="PrecisionScaleHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding PrecisionScaleHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="精准按键" VerticalAlignment="Center" Margin="0" />
                    <TextBlock Grid.Column="1" x:Name="PrecisionButtonReport" Classes="readout" VerticalAlignment="Center"
                               Text="{Binding PrecisionButtonLabel}" />
                    <TextBlock Grid.Column="2" Classes="hint" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="映射界面设置" />
                </Grid>
                <TextBlock x:Name="PrecisionButtonHint" Classes="hint" Margin="150,0,0,14"
                           Text="{Binding PrecisionButtonHint}" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="精准模式" VerticalAlignment="Center" Margin="0" />
                    <TextBlock Grid.Column="1" x:Name="PrecisionModeReport" Classes="readout" VerticalAlignment="Center"
                               Text="{Binding PrecisionModeLabel}" />
                    <TextBlock Grid.Column="2" Classes="hint" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="映射界面设置" />
                </Grid>
                <TextBlock x:Name="PrecisionModeHint" Classes="hint" Margin="150,0,0,14"
                           Text="触发方式随当前映射一起保存" />

                <CheckBox x:Name="InvertYBox" Content="垂直反转" IsChecked="{Binding InvertY, Mode=TwoWay}" />
                <TextBlock x:Name="InvertYHint" Classes="hint" Margin="0,4,0,0"
                           Text="{Binding InvertYHint}" />

                <Button Classes="primary" Content="应用" HorizontalAlignment="Left" Margin="0,18,0,0"
                        Command="{ReflectionBinding DataContext.ApplyMouseSensitivityCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Top">
                <TextBlock Classes="cardTitle" Text="实时预览" Margin="0,0,0,12" />
                <controls:SensitivityPreview x:Name="MousePreviewHost" />

                <Grid Margin="0,16,0,0" Width="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="当前速度" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="CurrentSpeedText" Classes="readout" VerticalAlignment="Center"
                               Text="{Binding CurrentSpeed, StringFormat='{}{0:F0} px/s'}" />
                </Grid>
                <Grid Margin="0,6,0,0" Width="200">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="累计位移" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                               Text="{Binding TravelDistance, StringFormat='{}{0:F0} px'}" />
                </Grid>

                <StackPanel Margin="0,18,0,0" Width="240">
                    <TextBlock Classes="cardTitle" Text="预览输入" Margin="0,0,0,8" />
                    <RadioButton x:Name="DemoModeRadio" Content="演示动画" GroupName="MousePreviewInput"
                                 IsChecked="{Binding IsRealInputMode, Converter={StaticResource Not}, Mode=TwoWay}" />
                    <RadioButton x:Name="RealInputModeRadio" Content="真实输入校准" GroupName="MousePreviewInput" Margin="0,6,0,0"
                                 IsChecked="{Binding IsRealInputMode, Mode=TwoWay}" />
                    <TextBlock Classes="hint" Margin="0,8,0,0" Text="{Binding RealInputHint}" />
                </StackPanel>

                <StackPanel x:Name="RealInputCard" Margin="0,18,0,0" Width="240" IsVisible="{Binding IsRealInputMode}">
                    <TextBlock Classes="cardTitle" Text="输入链路" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="原始摇杆" VerticalAlignment="Center" Margin="0" />
                        <TextBlock Grid.Column="1" x:Name="RawStickXText" Classes="readout" VerticalAlignment="Center"
                                   Text="{Binding RawStickX, StringFormat='X {0:F2}'}" />
                        <TextBlock Grid.Column="2" x:Name="RawStickYText" Classes="readout" VerticalAlignment="Center"
                                   Text="{Binding RawStickY, StringFormat='Y {0:F2}'}" />
                        <TextBlock Grid.Column="3" x:Name="RawMagnitudeText" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding RawMagnitude, StringFormat='|{0:F2}|'}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="死区过滤后" VerticalAlignment="Center" Margin="0" />
                        <TextBlock Grid.Column="1" x:Name="FilteredStickXText" Classes="readout" VerticalAlignment="Center"
                                   Text="{Binding FilteredStickX, StringFormat='X {0:F2}'}" />
                        <TextBlock Grid.Column="2" x:Name="FilteredStickYText" Classes="readout" VerticalAlignment="Center"
                                   Text="{Binding FilteredStickY, StringFormat='Y {0:F2}'}" />
                        <TextBlock Grid.Column="3" x:Name="FilteredMagnitudeText" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding FilteredMagnitude, StringFormat='|{0:F2}|'}" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="日常速度" VerticalAlignment="Center" Margin="0" />
                        <TextBlock Grid.Column="1" x:Name="DailySpeedText" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding DailySpeed, StringFormat='{}{0:F0} px/s'}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="fieldLabel" Text="精准速度" VerticalAlignment="Center" Margin="0" />
                        <TextBlock Grid.Column="1" x:Name="PrecisionSpeedText" Classes="readout" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding PrecisionSpeed, StringFormat='{}{0:F0} px/s'}" />
                    </Grid>

                    <!-- 静差采集. The measurement rides the preview clock, so holding the
                         stick still fills the distribution: the status line reports the sample
                         count while collecting and the mean/peak once there is enough data,
                         and the deadzone the distribution suggests stays a suggestion until
                         it is confirmed with the button below. -->
                    <StackPanel x:Name="DriftCard" Margin="0,18,0,0">
                        <TextBlock Classes="cardTitle" Text="静差采集" Margin="0,0,0,8" />
                        <TextBlock Classes="hint" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="{Binding DriftHint}" />

                        <Border Background="{DynamicResource SubtleBrush}"
                                CornerRadius="{DynamicResource CornerRadiusMd}"
                                Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="DriftStatusText" Classes="hint"
                                           VerticalAlignment="Center" Margin="0" TextWrapping="Wrap"
                                           Text="{Binding DriftStatus}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Classes="fieldLabel" Text="建议死区" HorizontalAlignment="Right" Margin="0" />
                                    <TextBlock x:Name="SuggestedDeadZoneText" Classes="readout" HorizontalAlignment="Right"
                                               Text="{Binding SuggestedDeadZoneText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- One primary action at a time - 开始采集 arms the collection,
                             停止采集 ends it and leaves the suggestion to confirm - and the
                             apply stays disabled until there is something to confirm. -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartDriftButton" Classes="primary" Content="开始采集" MinHeight="32"
                                    IsVisible="{Binding IsMeasuringDrift, Converter={StaticResource Not}}"
                                    Command="{Binding StartDriftMeasurementCommand}" />
                            <Button x:Name="StopDriftButton" Classes="primary" Content="停止采集" MinHeight="32"
                                    IsVisible="{Binding IsMeasuringDrift}"
                                    Command="{Binding StopDriftMeasurementCommand}" />
                            <Button x:Name="ApplyDeadZoneButton" Classes="ghost" Content="采用建议死区" MinHeight="32"
                                    Margin="8,0,0,0" IsEnabled="{Binding CanApplySuggestion}"
                                    Command="{Binding ApplySuggestedDeadZoneCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Classes="cardTitle" Text="响应曲线" Margin="0,22,0,12" />
                <controls:ResponseCurveGraph x:Name="CurveGraphHost" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
