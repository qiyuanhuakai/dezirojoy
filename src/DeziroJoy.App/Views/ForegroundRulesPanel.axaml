<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:mapping="clr-namespace:DeziroJoy.Core.Mapping;assembly=DeziroJoy.Core"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             x:Class="DeziroJoy.App.Views.ForegroundRulesPanel"
             x:DataType="vm:ForegroundRulesViewModel">

    <!--
        The 前台规则 surface: which program runs which profile, which programs get the pad
        themselves, and - the question the user actually asks - why the profile that is running
        right now is the one running. Every line here reads the live watcher through this view
        model; nothing is a second copy of the state.

        The active-state card comes first on purpose: the explanation is the feature's whole
        point, so it is the first thing on screen and the last thing to scroll away.

        The surface is one rounded panel with two hairlines through it rather than three cards
        stacked on each other: the three settings - what runs now, what the desktop falls back
        to, and the table - are one page, and a frame around each of them read as three separate
        surfaces rather than as one. The hairline is what separates, and it costs no padding and
        no second radius.

        Every interactive control on the surface is one size - 32 tall, one corner radius, one
        type size - because the panel used to size its buttons one at a time and a row of them
        read as three different controls. The drop-downs are the editors for both slot fields: a
        slot is a choice among the presets the store holds, and a number box made the user count
        to it. The priority is the one field that is typed, so it is the one plain text field.

        The rule table is a flat list, not a card per rule: a card inside this panel's card is
        two frames deep, and a table of five rules read as five boxes reads as five separate
        surfaces rather than as one list. A rule row is a summary line - what it does and what it
        costs to be considered - with a hairline under it, and the editing fields sit under that
        line only while the row is open. The row is read far more often than it is written, so
        the fields are the thing that collapses; the enable and delete controls do not, because
        neither needs the row open to be used.
    -->

    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="Not" />

        <!-- The row's twisty. A filled chevron rather than a text glyph, so it keeps the
             control's ink and stays crisp at the row's small type size; each geometry is drawn
             in a 7x7 space and the PathIcon's viewbox scales it down to the 8x6 it occupies. -->
        <StreamGeometry x:Key="RuleRowChevronRight">M1.5,0 L7,3.5 L1.5,7 Z</StreamGeometry>
        <StreamGeometry x:Key="RuleRowChevronDown">M0,1.5 L7,1.5 L3.5,7 Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ===================== surfaces ===================== -->
        <!-- The one panel the three settings sit in. Rounded at the panel radius, on the card
             surface, so the page reads as a single sheet with sections rather than as a stack
             of boxes. -->
        <Style Selector=":is(Border).panelCard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusXl}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- The section break. A hairline rather than a gap and a second card: it separates
             without taking the space a frame and its padding would, and it is the only thing
             that says where one setting ends and the next begins. -->
        <Style Selector="Border.sectionSeparator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Margin" Value="0,18,0,18" />
        </Style>

        <!-- The row: one line of identity and the two controls that need no editing, with a
             hairline under it. No card, no background - the list's rhythm is the separator's. -->
        <Style Selector="Border.ruleRow">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Padding" Value="0,0,0,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- ===================== typography ===================== -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- A form row's label. Centred against the 32-tall control beside it, so the label and
             the field share one optical line instead of the label sitting above it. -->
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style Selector="TextBlock.panelHint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.ruleSummary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===================== controls ===================== -->
        <!-- One metric for every field on the surface: 32 tall, the form-control corner, the
             same type size, and a 4px margin top and bottom so a form row is 40 tall and the
             label beside it is centred on the same line. The panel used to size these one at a
             time - 76 here, 96 there, 8,4 on one button and 14,8 on the next - and a form whose
             rows end at three different widths is a form that does not read as one. -->
        <Style Selector="TextBox.formInput">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox.formCombo">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- The theme sizes a combo box to its content; a form field has to fill the
                 column it is given, or the editors of a row end at three different widths
                 and the row stops reading as one form. -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- The row's enable switch: the same height as the controls beside it, so the summary
             line is one line and not a line with a checkbox floating off it. -->
        <Style Selector="CheckBox.rowCheck">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ===================== buttons ===================== -->
        <!-- Every button on the surface is this box: 32 tall, one corner, one padding, one type
             size. The only differences left are the fill - quiet for the per-row delete, accent
             for the one action the panel exists to take - and those are colours, not sizes, so
             a row of buttons reads as a row of the same control. -->
        <Style Selector="Button.panelButton">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- State changes are transitions, not instant flips, and they only touch brushes
                 and opacity: nothing here moves the button or resizes it, so a pointer sweep
                 across a row never shifts a target mid-click. -->
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.panelButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="Button.panelButton:pressed">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- The one primary action: 保存并生效. Accent fill, accent ink, and the same box as
             everything else - a primary button that is a different size is a different control. -->
        <Style Selector="Button.panelButton.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.panelButton.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <!-- The per-row delete: the same box, quieter, so the row's own control is never the
             loudest thing on the row it sits in. -->
        <Style Selector="Button.panelButton.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="Button.panelButton.quiet:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- The row's twisty: a quiet square of nothing until it is pointed at, which is what
             a control that opens and closes a row should be. -->
        <Style Selector="ToggleButton.ruleTwisty">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSm}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.ruleTwisty:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="ToggleButton.ruleTwisty:pressed">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- An open row says so with the same wash, so the chevron is not the only thing that
             changed when the row opened. -->
        <Style Selector="ToggleButton.ruleTwisty:checked">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="20,16" MaxWidth="720">

            <TextBlock Classes="pageTitle" Text="前台规则" Margin="0,0,0,4" />
            <TextBlock Classes="panelHint" Margin="0,0,0,14"
                       Text="按当前前台程序选择配置：命中规则时切换到该规则指定的预设，没有任何规则命中时使用下方的桌面默认配置；需要原生手柄输入的程序则暂停键鼠映射。" />

            <!-- The one surface: what runs now, what the desktop falls back to, and the table,
                 divided by hairlines rather than by frames. -->
            <Border Classes="panelCard">
                <StackPanel>

                    <!-- The active state, and the reason it is the active one. -->
                    <TextBlock Classes="sectionTitle" Text="当前生效" />
                    <Grid Margin="0,12,0,0" ColumnDefinitions="88,*">
                        <TextBlock Grid.Column="0" Classes="formLabel" Text="前台程序" />
                        <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                   x:Name="ForegroundProcessText"
                                   Text="{Binding ForegroundProcessText}" />
                    </Grid>
                    <Grid Margin="0,8,0,0" ColumnDefinitions="88,*">
                        <TextBlock Grid.Column="0" Classes="formLabel" Text="生效配置" />
                        <TextBlock Grid.Column="1" Classes="readout" VerticalAlignment="Center"
                                   x:Name="ActiveProfileText"
                                   Text="{Binding ActiveProfileText}" />
                    </Grid>

                    <!-- The locked state. Accent ink while locked: it is a state the user must
                         never have to guess about, and it says what is frozen and what stands
                         down rather than just "on". -->
                    <TextBlock Classes="panelHint" Margin="0,12,0,0"
                               x:Name="ActiveReasonText"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding ActiveReason}" />
                    <TextBlock Classes="panelHint" Margin="0,10,0,0"
                               x:Name="LockStateText"
                               IsVisible="{Binding IsLocked}"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding LockStateText}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                        <Button x:Name="RefreshRulesButton" Classes="panelButton" Content="立即检测"
                                Command="{Binding RefreshCommand}" />
                        <Button x:Name="ToggleLockButton" Classes="panelButton"
                                Content="{Binding LockButtonText}" Command="{Binding ToggleLockCommand}" />
                    </StackPanel>
                    <TextBlock Classes="panelHint" Margin="0,8,0,0"
                               Text="锁定后前台规则暂停生效，保持当前配置不变；再次点击解锁并交还控制权。" />

                    <Border Classes="sectionSeparator" />

                    <!-- The desktop default, and the on/off switch. -->
                    <TextBlock Classes="sectionTitle" Text="桌面默认" />
                    <Grid Margin="0,12,0,0" ColumnDefinitions="88,*,Auto">
                        <TextBlock Grid.Column="0" Classes="formLabel" Text="默认预设" />
                        <!-- A drop-down of the presets the store holds, not a number box: the
                             slot is a choice among named presets, and counting to it through
                             up/down arrows was asking the user to remember a list the panel
                             already has. -->
                        <ComboBox Grid.Column="1" Classes="formCombo"
                                  x:Name="DefaultSlotCombo"
                                  PlaceholderText="选择预设"
                                  ItemsSource="{Binding SlotOptions}"
                                  SelectedItem="{Binding DefaultSlotOption, Mode=TwoWay}"
                                  DropDownOpened="OnSlotPickerDropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetSlotOption">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate x:DataType="vm:PresetSlotOption">
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Classes="panelHint" VerticalAlignment="Center"
                                   Margin="12,4,0,4" MaxWidth="200" TextWrapping="Wrap"
                                   Text="没有规则命中、以及停在桌面时使用该预设。" />
                    </Grid>
                    <CheckBox Classes="rowCheck" Margin="14,4,0,4"
                              x:Name="ForegroundEnabledBox" Content="启用前台规则"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    <TextBlock Classes="panelHint" Margin="0,8,0,0"
                               Text="关闭后前台规则暂停生效，始终使用桌面默认配置；规则表会保留，重新打开即可恢复。" />

                    <Border Classes="sectionSeparator" />

                    <!-- The rule table. -->
                    <TextBlock Classes="sectionTitle" Text="规则" />
                    <TextBlock Classes="panelHint" Margin="0,6,0,0"
                               Text="按进程名匹配（大小写、.exe 后缀不影响）；优先级数值大的先匹配，数值相同时按列表顺序。填 * 表示任意程序。" />
                    <TextBlock Classes="panelHint" Margin="0,6,0,0"
                               Text="规则行默认折叠成一行摘要，点开后才编辑；摘要上的「启用」和「删除」不需要展开就能用。程序名也可以从当前打开的窗口里选：展开规则行，在「从当前窗口选择」下拉框中选中即填入该规则的程序名。" />
                    <!-- The picker's own hint, and the honest one where the platform cannot
                         enumerate: an empty drop-down has to say why it is empty. -->
                    <TextBlock Classes="panelHint" Margin="0,6,0,0"
                               IsVisible="{Binding HasWindowChoices, Converter={StaticResource Not}}"
                               Text="当前平台无法列出已打开的窗口，请手动输入进程名。" />

                    <ItemsControl x:Name="RulesList" Margin="0,14,0,0" ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ForegroundRuleItem">
                                <Border Classes="ruleRow">
                                    <StackPanel>
                                        <!-- The summary line: the row's identity, its twisty,
                                             and the two controls that work on a closed row. -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <ToggleButton Grid.Column="0" Classes="ruleTwisty"
                                                          x:Name="RuleExpandButton"
                                                          AutomationProperties.Name="展开或收起规则"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                <Grid>
                                                    <PathIcon Width="8" Height="6"
                                                              Data="{StaticResource RuleRowChevronRight}"
                                                              IsVisible="{Binding IsExpanded, Converter={StaticResource Not}}" />
                                                    <PathIcon Width="8" Height="6"
                                                              Data="{StaticResource RuleRowChevronDown}"
                                                              IsVisible="{Binding IsExpanded}" />
                                                </Grid>
                                            </ToggleButton>
                                            <TextBlock Grid.Column="1" Classes="ruleSummary"
                                                       x:Name="RuleSummaryText"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding Summary}" />
                                            <CheckBox Grid.Column="2" Classes="rowCheck" Content="启用"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                            <Button Grid.Column="3" Classes="panelButton quiet" Content="删除"
                                                    Margin="8,0,0,0"
                                                    x:Name="RuleDeleteButton"
                                                    Command="{ReflectionBinding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <!-- The editing fields. Only while the row is open: a
                                             row that always showed every field made a table of
                                             five rules taller than the window, and the table is
                                             read far more often than it is written. -->
                                        <Grid Margin="0,8,0,0" IsVisible="{Binding IsExpanded}"
                                              ColumnDefinitions="88,120,Auto,*">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="formLabel"
                                                       Text="程序名" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                                     Classes="formInput" x:Name="RuleProcessBox"
                                                     Text="{Binding ProcessName, Mode=TwoWay}" />

                                            <!-- The picker: the windows the platform reports as
                                                 open right now, so a rule can name its program
                                                 by pointing at it. Selection fills the program
                                                 name and clears, so the placeholder returns
                                                 and the same window can be picked twice. -->
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                      Classes="formCombo"
                                                      x:Name="RuleWindowPicker"
                                                      PlaceholderText="从当前窗口选择…"
                                                      ItemsSource="{ReflectionBinding DataContext.WindowChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                                                      DropDownOpened="OnWindowPickerDropDownOpened">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="mapping:ForegroundWindow">
                                                        <TextBlock Text="{Binding Display}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="formLabel"
                                                       Text="优先级" />
                                            <!-- Typed, not spun: a priority is a number the user
                                                 types, and the up/down pair was a column of
                                                 chrome nobody pressed. -->
                                            <TextBox Grid.Row="2" Grid.Column="1"
                                                     Classes="formInput" x:Name="RulePriorityBox"
                                                     Text="{Binding PriorityText, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Classes="formLabel"
                                                       Text="动作" />
                                            <ComboBox Grid.Row="2" Grid.Column="3"
                                                      Classes="formCombo" x:Name="RuleActionCombo"
                                                      SelectedIndex="{Binding ActionIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="切换配置" />
                                                <ComboBoxItem Content="原生手柄" />
                                            </ComboBox>

                                            <!-- The slot the rule activates: a drop-down of the
                                                 presets the store holds, so the rule names its
                                                 preset rather than a number. Hidden for a
                                                 native-gamepad rule: mapping is paused there,
                                                 so which profile would run is moot. -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="formLabel"
                                                       IsVisible="{Binding IsProfileAction}"
                                                       Text="切换到预设" />
                                            <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                                      Classes="formCombo" x:Name="RuleSlotCombo"
                                                      IsVisible="{Binding IsProfileAction}"
                                                      PlaceholderText="选择预设"
                                                      ItemsSource="{ReflectionBinding DataContext.SlotOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedSlotOption, Mode=TwoWay}"
                                                      DropDownOpened="OnSlotPickerDropDownOpened">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PresetSlotOption">
                                                        <TextBlock Text="{Binding Display}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                                <ComboBox.SelectionBoxItemTemplate>
                                                    <DataTemplate x:DataType="vm:PresetSlotOption">
                                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.SelectionBoxItemTemplate>
                                            </ComboBox>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                                       Classes="panelHint" Margin="0,8,0,0"
                                                       IsVisible="{Binding IsProfileAction}"
                                                       Text="该程序在前台时使用这个预设。" />

                                            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                                                       Classes="panelHint" Margin="0,10,0,0"
                                                       IsVisible="{Binding IsNativeGamepadAction}"
                                                       Text="该程序在前台时暂停键鼠映射，让游戏直接读取手柄；离开后自动恢复。" />

                                            <CheckBox Grid.Row="6" Grid.Column="1" Classes="rowCheck"
                                                      Margin="14,4,0,4"
                                                      Content="仅全屏时生效"
                                                      IsChecked="{Binding FullscreenOnly, Mode=TwoWay}" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                                                       Classes="panelHint" Margin="0,8,0,0"
                                                       Text="「仅全屏」是辅助条件：平台检测不到是否全屏时规则仍然命中（Wayland 无法读取前台），可随时取消勾选。" />

                                            <!-- A rule that can never match says so, rather than sitting
                                                 in the table looking like it does something. -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                                                       Classes="panelHint" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       IsVisible="{Binding IsValid, Converter={StaticResource Not}}"
                                                       Text="{Binding ValidationMessage}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button x:Name="AddRuleButton" Classes="panelButton" Content="新增规则"
                                Command="{Binding AddRuleCommand}" />
                        <Button x:Name="SaveRulesButton" Classes="panelButton primary" Content="保存并生效"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                        <Button x:Name="RevertRulesButton" Classes="panelButton" Content="放弃更改"
                                Command="{Binding RevertCommand}" IsEnabled="{Binding HasUnsavedChanges}" />
                    </StackPanel>

                    <TextBlock Classes="panelHint" Margin="0,10,0,0"
                               x:Name="RulesStatusText"
                               IsVisible="{Binding HasStatusMessage}"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding StatusMessage}" />

                    <TextBlock Classes="panelHint" Margin="0,10,0,0"
                               x:Name="SourceNoteText"
                               Text="{Binding SourceNote}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
