<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             x:Class="DeziroJoy.App.Views.Controls.GenericGamepadPanel"
             x:DataType="vm:GenericGamepadPanelViewModel">
    <!--
        The data-driven gamepad panel. Every control is one item from the device's own
        declaration - there is no型号图 here and nothing is drawn for a control the device
        did not name. The five zones are the Core's fixed arrangement: 方向 on the left,
        主按钮 on the right, 肩键与扳机 across the top, 功能键 and 扩展 in their own strips.
        Order inside a zone is the declaration order, so a control being detected or hidden
        never re-arranges its neighbours.

        The layout is responsive rather than a fixed design size: the zones live in one
        scroll region and the 更多输入 bar is pinned below it, so a long declaration
        scrolls instead of pushing the bar out of sight, and a narrow stage wraps the cards
        instead of overlapping them. Every card carries the same width, so a zone reads as
        an even grid whatever the stage's shape.
    -->
    <UserControl.Resources>
        <!-- One control: the card that opens its mapping settings and, beside it in its own
             reserved column, the hide affordance (bound controls refuse one). The badge
             column is the same 16px on every card whether it shows or not, so the cards stay
             uniform and the affordance never steals the card's width or sits on top of it -
             a fixed-width card sharing one row between the two used to overlap them. The
             device's own label can be long ("Back / Select"), so it wraps and ellipsises
             inside the card instead of running over its edge or its neighbour.
             For a stick, the two independent switches sit below the card: appearance says
             how the control is drawn and changes nothing about mappings, the execution mode
             is rewritten as mappings. They are separate buttons because they are separate
             questions. -->
        <DataTemplate x:Key="ControlCard" x:DataType="vm:GenericControlItem">
            <Border Width="80" Margin="3">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="16" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Classes="genericCard" MinHeight="40"
                            Classes.live="{Binding IsLive}"
                            Classes.pressed="{Binding IsPressed}"
                            Classes.capture="{Binding IsCaptureTarget}"
                            Command="{Binding OpenCommand}">
                        <StackPanel>
                            <!-- The stick's glyph: the round pad or the cross, whichever the
                                 appearance switch says. Appearance only - it draws the
                                 control and changes nothing about what a mapping does. -->
                            <Panel IsVisible="{Binding IsStick}" Height="20" HorizontalAlignment="Center">
                                <Ellipse Width="18" Height="18" Stroke="{DynamicResource StickRingBrush}"
                                         StrokeThickness="1.5" Fill="{DynamicResource PadIdleBrush}"
                                         IsVisible="{Binding IsStickGlyph}" />
                                <Path Width="18" Height="18" Fill="{DynamicResource PadIdleBrush}"
                                      Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                                      Data="M7,1 L11,1 L11,7 L17,7 L17,11 L11,11 L11,17 L7,17 L7,11 L1,11 L1,7 L7,7 Z"
                                      IsVisible="{Binding IsDpadGlyph}" />
                            </Panel>
                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <TextBlock Text="{Binding StickModeLabel}" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HintTextBrush}"
                                       IsVisible="{Binding IsStick}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="1" Classes="genericMinor" Padding="0"
                            Height="18" VerticalAlignment="Top" HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Command="{Binding HideCommand}"
                            IsVisible="{Binding CanHide}"
                            Content="×"
                            ToolTip.Tip="隐藏此输入（仅影响显示，可恢复）" />
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="genericMinor"
                            HorizontalAlignment="Center"
                            Command="{Binding SwitchAppearanceCommand}"
                            IsVisible="{Binding IsStick}"
                            Content="{Binding StickAppearanceLabel}" />
                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="genericMinor"
                            HorizontalAlignment="Center"
                            Command="{Binding SwitchStickModeCommand}"
                            IsVisible="{Binding IsStick}"
                            Content="切换执行方式" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- One control card. The classes carry the live state rather than separate
             templates: bound is the resting look, live is the device's own answer that the
             control has been seen, pressed is the sample-time highlight, and capture marks
             the control the editor's button capture is armed for. -->
        <Style Selector="Button.genericCard">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.genericCard.live">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.genericCard.pressed">
            <Setter Property="Background" Value="{DynamicResource PadPressedBrush}" />
        </Style>
        <Style Selector="Button.genericCard.capture">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.genericMinor">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
        </Style>
        <Style Selector="TextBlock.zoneTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- The five zones in one scroll region. A long declaration scrolls; the bar below
             it does not move, so 更多输入 is never pushed out of sight. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 肩键与扳机: the top strip, in the device's declaration order. -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Classes="zoneTitle" Text="肩键与扳机" />
                    <ItemsControl ItemsSource="{Binding ShoulderItems}" ItemTemplate="{StaticResource ControlCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 方向 on the left, 主按钮 on the right - the two zones the hands live on.
                     The split is proportional, so a narrow stage narrows both instead of
                     pushing one under the other. -->
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Classes="zoneTitle" Text="方向" />
                        <ItemsControl ItemsSource="{Binding DirectionItems}" ItemTemplate="{StaticResource ControlCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Classes="zoneTitle" Text="主按钮" />
                        <ItemsControl ItemsSource="{Binding MainButtonItems}" ItemTemplate="{StaticResource ControlCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- 功能键: back, start, guide and the stick clicks. -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Classes="zoneTitle" Text="功能键" />
                    <ItemsControl ItemsSource="{Binding FunctionItems}" ItemTemplate="{StaticResource ControlCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 扩展: everything with no standard position - misc keys, paddles, the touchpad. -->
                <StackPanel>
                    <TextBlock Classes="zoneTitle" Text="扩展" />
                    <ItemsControl ItemsSource="{Binding ExtensionItems}" ItemTemplate="{StaticResource ControlCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The 更多输入 bar: controls the device declares but that have never been detected
             wait here, in their fixed order. 显示全部输入 promotes them onto the panel for a
             full inspection; 恢复 brings back anything the user hid. The bar is pinned below
             the scroll region, so it stays reachable however long the declaration is. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Classes="genericMinor"
                    Command="{Binding ToggleShowAllCommand}"
                    Content="{Binding ShowAllLabel}" />
            <Button Grid.Column="1" Classes="genericMinor"
                    Command="{Binding RestoreHiddenCommand}"
                    IsVisible="{Binding HasHidden}"
                    Content="恢复隐藏的输入" />
            <TextBlock Grid.Column="3" Classes="zoneTitle" Margin="8,0,0,0"
                       Text="{Binding MoreInputCount, StringFormat='更多输入 {0} 项'}" />
        </Grid>
    </Grid>
</UserControl>
