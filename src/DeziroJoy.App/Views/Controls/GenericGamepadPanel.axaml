<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             x:Class="DeziroJoy.App.Views.Controls.GenericGamepadPanel"
             x:DataType="vm:GenericGamepadPanelViewModel">
    <!--
        The data-driven gamepad panel. Every control is one item from the device's own
        declaration - there is no型号图 here and nothing is drawn for a control the device
        did not name. The five zones are the Core's fixed arrangement: 方向 on the left,
        主按钮 on the right, 肩键与扳机 across the top, 功能键 and 扩展 in their own strips.
        Order inside a zone is the declaration order, so a control being detected or hidden
        never re-arranges its neighbours.

        The layout is responsive rather than a fixed design size: the zones live in one
        scroll region and the action bar is pinned below it, so a long declaration scrolls
        instead of pushing the bar out of sight, and a narrow stage reflows the cards instead
        of overlapping them. Every card carries the same width, so a zone reads as an even
        grid whatever the stage's shape - and the face buttons arrange as a 2x2 block, the
        pad's own diamond, instead of four cards stretched across the stage.
    -->
    <UserControl.Resources>
        <!-- One control, one button: the card opens the control's mapping settings and
             carries the live states. Every other per-control action - hide, and for a stick
             the appearance and execution-mode switches - acts on the control the editor has
             open, from the bar below the zones. That keeps the cards one even grid of
             single-line buttons: no badge column to misalign them, no wrapped labels, no
             stacked switches, and the actions stay reachable by pointer and by gamepad
             navigation alike, which a hover-revealed badge would not be. A label longer
             than the card ellipsises with the full text on the card's tooltip, so nothing
             is silently clipped. -->
        <DataTemplate x:Key="ControlCard" x:DataType="vm:GenericControlItem">
            <Button Width="64" MinHeight="30" Margin="2" Classes="genericCard"
                    Classes.live="{Binding IsLive}"
                    Classes.pressed="{Binding IsPressed}"
                    Classes.capture="{Binding IsCaptureTarget}"
                    Command="{Binding OpenCommand}"
                    ToolTip.Tip="{Binding Label}">
                <StackPanel>
                    <!-- The stick's glyph: the round pad or the cross, whichever the
                         appearance switch says. Appearance only - it draws the control and
                         changes nothing about what a mapping does. -->
                    <Panel IsVisible="{Binding IsStick}" Height="14" HorizontalAlignment="Center">
                        <Ellipse Width="13" Height="13" Stroke="{DynamicResource StickRingBrush}"
                                 StrokeThickness="1.5" Fill="{DynamicResource PadIdleBrush}"
                                 IsVisible="{Binding IsStickGlyph}" />
                        <Path Width="13" Height="13" Fill="{DynamicResource PadIdleBrush}"
                              Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                              Data="M7,1 L11,1 L11,7 L17,7 L17,11 L11,11 L11,17 L7,17 L7,11 L1,11 L1,7 L7,7 Z"
                              IsVisible="{Binding IsDpadGlyph}" />
                    </Panel>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- One control card. The classes carry the live state rather than separate
             templates: bound is the resting look, live is the device's own answer that the
             control has been seen, pressed is the sample-time highlight, and capture marks
             the control the editor's button capture is armed for. -->
        <Style Selector="Button.genericCard">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMd}" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.genericCard.live">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.genericCard.pressed">
            <Setter Property="Background" Value="{DynamicResource PadPressedBrush}" />
        </Style>
        <Style Selector="Button.genericCard.capture">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.genericMinor">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
        </Style>
        <Style Selector="TextBlock.zoneTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- The five zones in one scroll region. A long declaration scrolls; the bar below
             it does not move, so 更多输入 is never pushed out of sight. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">            <StackPanel>
                <!-- 肩键与扳机: the top strip, in the device's declaration order. -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Classes="zoneTitle" Text="肩键与扳机" />
                    <ItemsControl ItemsSource="{Binding ShoulderItems}" ItemTemplate="{StaticResource ControlCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 方向 on the left, 主按钮 on the right - the two zones the hands live on.
                     The split is proportional, so a narrow stage narrows both instead of
                     pushing one under the other. The face buttons arrange as a 2x2 block:
                     four of them read as the pad's own diamond, and the block stays square
                     instead of stretching four cards across the stage's whole width. -->
                <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Classes="zoneTitle" Text="方向" />
                        <ItemsControl ItemsSource="{Binding DirectionItems}" ItemTemplate="{StaticResource ControlCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Classes="zoneTitle" Text="主按钮" />
                        <ItemsControl ItemsSource="{Binding MainButtonItems}" ItemTemplate="{StaticResource ControlCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- 功能键: back, start, guide and the stick clicks. -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Classes="zoneTitle" Text="功能键" />
                    <ItemsControl ItemsSource="{Binding FunctionItems}" ItemTemplate="{StaticResource ControlCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 扩展: everything with no standard position - misc keys, paddles, the touchpad. -->
                <StackPanel>
                    <TextBlock Classes="zoneTitle" Text="扩展" />
                    <ItemsControl ItemsSource="{Binding ExtensionItems}" ItemTemplate="{StaticResource ControlCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The action bar, pinned below the scroll region so it stays reachable however
             long the declaration is. Its top row acts on the one control the mapping editor
             has open - hide, and for a stick the appearance and execution-mode switches -
             which is where the cards' own small buttons went; the row below is the panel's
             own pair, 显示全部输入 and 恢复, plus the 更多输入 count. -->
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <WrapPanel IsVisible="{Binding HasEditorControl}" Margin="0,0,0,4">
                <Button Classes="genericMinor" Margin="0,0,6,4"
                        IsVisible="{Binding EditorControlCanHide}"
                        Command="{Binding EditorControl.HideCommand}"
                        Content="隐藏此输入"
                        ToolTip.Tip="仅从面板隐藏该输入，可恢复；映射不受影响。" />
                <Button Classes="genericMinor" Margin="0,0,6,4"
                        IsVisible="{Binding EditorControlIsStick}"
                        Command="{Binding EditorControl.SwitchAppearanceCommand}"
                        Content="{Binding EditorControl.StickAppearanceLabel}"
                        ToolTip.Tip="切换该摇杆的绘制示意；不改变任何映射。" />
                <Button Classes="genericMinor" Margin="0,0,6,4"
                        IsVisible="{Binding EditorControlIsStick}"
                        Command="{Binding EditorControl.SwitchStickModeCommand}"
                        Content="切换执行方式"
                        ToolTip.Tip="在连续轴与四方向之间切换；会按选择重写该摇杆的映射。" />
                <TextBlock Classes="zoneTitle" VerticalAlignment="Center" Margin="0,0,0,4"
                           Text="{Binding EditorControl.Label, StringFormat='当前编辑：{0}'}" />
            </WrapPanel>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0" Classes="genericMinor"
                        Command="{Binding ToggleShowAllCommand}"
                        Content="{Binding ShowAllLabel}" />
                <Button Grid.Column="1" Classes="genericMinor"
                        Command="{Binding RestoreHiddenCommand}"
                        IsVisible="{Binding HasHidden}"
                        Content="恢复隐藏的输入" />
                <TextBlock Grid.Column="3" Classes="zoneTitle" Margin="8,0,0,0"
                           Text="{Binding MoreInputCount, StringFormat='更多输入 {0} 项'}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
