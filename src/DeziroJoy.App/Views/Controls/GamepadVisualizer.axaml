<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             x:Class="DeziroJoy.App.Views.Controls.GamepadVisualizer"
             x:DataType="vm:GamepadVisualizerViewModel">
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="PadBrush" PressedKey="PadPressedBrush" IdleKey="PadIdleBrush" />
        <conv:BoolToDoubleConverter x:Key="ConnectedOpacity" TrueValue="1" FalseValue="0.4" />
        <conv:BoolNegationConverter x:Key="Not" />
    </UserControl.Resources>

    <!--
        The model is the editor, not a status panel: every mappable element carries the
        padHit class so it gets the hand cursor and the hover ring, and each one routes its
        PointerPressed to the code-behind, which turns the element into an InputBinding and
        raises ElementClicked. Live gamepad input still drives the pressed fill, so the two
        ways of pointing at an element agree.

        Rounded bars (triggers, bumpers, dpad arms) are Borders rather than Rectangles:
        Avalonia does not hit-test a Rectangle that has RadiusX/RadiusY set, so a rounded
        Rectangle would draw correctly but never receive a click.
    -->
    <UserControl.Styles>
        <Style Selector="Shape.padHit">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Shape.padHit:pointerover">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.padHit">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.padHit:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Width="320" Height="244">
        <Canvas x:Name="PadCanvas" Opacity="{Binding IsConnected, Converter={StaticResource ConnectedOpacity}}">

            <Rectangle x:Name="PadBody" Canvas.Left="8" Canvas.Top="34" Width="304" Height="164"
                       RadiusX="46" RadiusY="46" Fill="{DynamicResource PadBodyBrush}" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"
                       Effect="{DynamicResource PadShadowEffect}" />

             <Border x:Name="LeftTrigger" Classes="padHit" Canvas.Left="44" Canvas.Top="6" Width="54" Height="12"
                     CornerRadius="6" Background="{Binding IsLeftTriggerPressed, Converter={StaticResource PadBrush}}"
                     BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                     ToolTip.Tip="左扳机 LT" PointerPressed="OnElementPressed" Tag="Button:LeftTrigger" />
             <Border x:Name="RightTrigger" Classes="padHit" Canvas.Left="222" Canvas.Top="6" Width="54" Height="12"
                     CornerRadius="6" Background="{Binding IsRightTriggerPressed, Converter={StaticResource PadBrush}}"
                     BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                     ToolTip.Tip="右扳机 RT" PointerPressed="OnElementPressed" Tag="Button:RightTrigger" />
             <Border x:Name="LeftBumper" Classes="padHit" Canvas.Left="38" Canvas.Top="20" Width="66" Height="14"
                     CornerRadius="7" Background="{Binding IsLeftBumperPressed, Converter={StaticResource PadBrush}}"
                     BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                     ToolTip.Tip="左肩键 LB" PointerPressed="OnElementPressed" Tag="Button:LeftBumper" />
             <Border x:Name="RightBumper" Classes="padHit" Canvas.Left="216" Canvas.Top="20" Width="66" Height="14"
                     CornerRadius="7" Background="{Binding IsRightBumperPressed, Converter={StaticResource PadBrush}}"
                     BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                     ToolTip.Tip="右肩键 RB" PointerPressed="OnElementPressed" Tag="Button:RightBumper" />

            <Ellipse x:Name="LeftStickPad" Classes="padHit" Canvas.Left="48" Canvas.Top="80" Width="52" Height="52"
                     Fill="{DynamicResource StickPadBrush}" Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                     PointerPressed="OnElementPressed" Tag="Stick:Left" ToolTip.Tip="左摇杆" />
            <Ellipse x:Name="LeftStickRing" Canvas.Left="59" Canvas.Top="91" Width="30" Height="30"
                     Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False" />
            <Ellipse x:Name="LeftStickThumb" Canvas.Left="63" Canvas.Top="95" Width="22" Height="22"
                     Fill="{DynamicResource StickThumbBrush}" IsHitTestVisible="False" />
            <Ellipse x:Name="LeftStickClick" Classes="padHit" Canvas.Left="67" Canvas.Top="133" Width="14" Height="14"
                     Fill="{Binding IsLeftStickPressed, Converter={StaticResource PadBrush}}"
                     Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                     PointerPressed="OnElementPressed" Tag="Button:LeftStick" ToolTip.Tip="左摇杆按下" />

            <Ellipse x:Name="RightStickPad" Classes="padHit" Canvas.Left="220" Canvas.Top="116" Width="52" Height="52"
                     Fill="{DynamicResource StickPadBrush}" Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                     PointerPressed="OnElementPressed" Tag="Stick:Right" ToolTip.Tip="右摇杆" />
            <Ellipse x:Name="RightStickRing" Canvas.Left="231" Canvas.Top="127" Width="30" Height="30"
                     Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False" />
            <Ellipse x:Name="RightStickThumb" Canvas.Left="235" Canvas.Top="131" Width="22" Height="22"
                     Fill="{DynamicResource StickThumbBrush}" IsHitTestVisible="False" />
            <Ellipse x:Name="RightStickClick" Classes="padHit" Canvas.Left="239" Canvas.Top="169" Width="14" Height="14"
                     Fill="{Binding IsRightStickPressed, Converter={StaticResource PadBrush}}"
                     Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                     PointerPressed="OnElementPressed" Tag="Button:RightStick" ToolTip.Tip="右摇杆按下" />

            <Border x:Name="DpadUp" Classes="padHit" Canvas.Left="122" Canvas.Top="126" Width="12" Height="24"
                    CornerRadius="2" Background="{Binding IsDPadUpPressed, Converter={StaticResource PadBrush}}"
                    BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                    PointerPressed="OnElementPressed" Tag="Button:DPadUp" ToolTip.Tip="十字键 上" />
            <Border x:Name="DpadDown" Classes="padHit" Canvas.Left="122" Canvas.Top="150" Width="12" Height="24"
                    CornerRadius="2" Background="{Binding IsDPadDownPressed, Converter={StaticResource PadBrush}}"
                    BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                    PointerPressed="OnElementPressed" Tag="Button:DPadDown" ToolTip.Tip="十字键 下" />
            <Border x:Name="DpadLeft" Classes="padHit" Canvas.Left="104" Canvas.Top="144" Width="24" Height="12"
                    CornerRadius="2" Background="{Binding IsDPadLeftPressed, Converter={StaticResource PadBrush}}"
                    BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                    PointerPressed="OnElementPressed" Tag="Button:DPadLeft" ToolTip.Tip="十字键 左" />
            <Border x:Name="DpadRight" Classes="padHit" Canvas.Left="128" Canvas.Top="144" Width="24" Height="12"
                    CornerRadius="2" Background="{Binding IsDPadRightPressed, Converter={StaticResource PadBrush}}"
                    BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                    PointerPressed="OnElementPressed" Tag="Button:DPadRight" ToolTip.Tip="十字键 右" />
            <Rectangle x:Name="DpadCenter" Canvas.Left="122" Canvas.Top="144" Width="12" Height="12" RadiusX="2" RadiusY="2"
                       Fill="{DynamicResource DpadCenterBrush}" IsHitTestVisible="False" />

            <!-- Each face button and its letter share one panel. A Shape cannot hold a child in
                 Avalonia, so the only way to keep the two together is a shared parent: the
                 button moves, the letter moves with it, and neither can drift out of centre. -->
            <Canvas Canvas.Left="198" Canvas.Top="56" Width="22" Height="22">
                <Ellipse x:Name="ButtonY" Classes="padHit" Width="22" Height="22"
                         Fill="{Binding IsYPressed, Converter={StaticResource PadBrush}}"
                         Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                         PointerPressed="OnElementPressed" Tag="Button:Y" />
                <TextBlock Width="22" Height="22" LineHeight="22" Text="Y" FontSize="10"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>
            <Canvas Canvas.Left="174" Canvas.Top="80" Width="22" Height="22">
                <Ellipse x:Name="ButtonX" Classes="padHit" Width="22" Height="22"
                         Fill="{Binding IsXPressed, Converter={StaticResource PadBrush}}"
                         Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                         PointerPressed="OnElementPressed" Tag="Button:X" />
                <TextBlock Width="22" Height="22" LineHeight="22" Text="X" FontSize="10"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>
            <Canvas Canvas.Left="222" Canvas.Top="80" Width="22" Height="22">
                <Ellipse x:Name="ButtonB" Classes="padHit" Width="22" Height="22"
                         Fill="{Binding IsBPressed, Converter={StaticResource PadBrush}}"
                         Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                         PointerPressed="OnElementPressed" Tag="Button:B" />
                <TextBlock Width="22" Height="22" LineHeight="22" Text="B" FontSize="10"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>
            <Canvas Canvas.Left="198" Canvas.Top="104" Width="22" Height="22">
                <Ellipse x:Name="ButtonA" Classes="padHit" Width="22" Height="22"
                         Fill="{Binding IsAPressed, Converter={StaticResource PadBrush}}"
                         Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                         PointerPressed="OnElementPressed" Tag="Button:A" />
                <TextBlock Width="22" Height="22" LineHeight="22" Text="A" FontSize="10"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>

             <Ellipse x:Name="BackButton" Classes="padHit" Canvas.Left="138" Canvas.Top="64" Width="14" Height="14"
                      Fill="{Binding IsBackPressed, Converter={StaticResource PadBrush}}"
                      Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                      ToolTip.Tip="返回键 Back" PointerPressed="OnElementPressed" Tag="Button:Back" />
             <Ellipse x:Name="GuideButton" Classes="padHit" Canvas.Left="157" Canvas.Top="64" Width="14" Height="14"
                      Fill="{Binding IsGuidePressed, Converter={StaticResource PadBrush}}"
                      Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                      ToolTip.Tip="主页键 Guide" PointerPressed="OnElementPressed" Tag="Button:Guide" />
             <Ellipse x:Name="StartButton" Classes="padHit" Canvas.Left="176" Canvas.Top="64" Width="14" Height="14"
                      Fill="{Binding IsStartPressed, Converter={StaticResource PadBrush}}"
                      Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1"
                      ToolTip.Tip="开始键 Start" PointerPressed="OnElementPressed" Tag="Button:Start" />

            <!-- Unmapped evdev codes, drawn as pills under the pad body. -->
            <ItemsControl x:Name="ExtraButtonsHost" Canvas.Left="8" Canvas.Top="202" Width="304"
                          ItemsSource="{Binding ExtraButtonCodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="padHit" Tag="{Binding}" Background="{DynamicResource SubtleBrush}"
                                BorderBrush="{DynamicResource StickRingBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,1" Height="16"
                                PointerPressed="OnExtraButtonPressed">
                            <TextBlock Text="{Binding StringFormat='按键 {0}'}" FontSize="9"
                                       Foreground="{DynamicResource ControlForegroundBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <TextBlock x:Name="DisconnectedLabel" Text="未连接" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
