<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             x:Class="DeziroJoy.App.Views.Controls.GamepadVisualizer"
             x:DataType="vm:GamepadVisualizerViewModel">
    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="PadBrush" PressedKey="PadPressedBrush" IdleKey="PadIdleBrush" />
        <conv:BoolToDoubleConverter x:Key="ConnectedOpacity" TrueValue="1" FalseValue="0.4" />
        <conv:BoolNegationConverter x:Key="Not" />
    </UserControl.Resources>

    <!--
        The model is the editor, not a status panel: every mappable element carries the
        padHit class so it gets the hand cursor, the hover ring and keyboard focus, and each
        one routes its PointerPressed to the code-behind, which turns the element into an
        InputBinding and raises ElementClicked. Live gamepad input still drives the pressed
        fill, so the two ways of pointing at an element agree.

        The geometry is authored in the measured 420x321 CC0 Xbox reference frame and scaled
        uniformly into the 620x380 stage by the Viewbox that hosts this control, so the
        proportions below are the reference's own: the body runs out to flared grips with a
        concave underside, the shoulders are continuous with the body, LB/RB sit on the
        shoulder line with LT/RT emerging from behind them, the left stick is high and
        outboard while the right stick is low and inboard, ABXY is an equal diamond, the
        D-pad is a cross inside a circular tray, and the centre cluster is a large Guide
        flanked by smaller View and Menu buttons.

        Rounded bars (triggers, bumpers, dpad arms) are Borders rather than Rectangles:
        Avalonia does not hit-test a Rectangle that has RadiusX/RadiusY set, so a rounded
        Rectangle would draw correctly but never receive a click.
    -->
    <UserControl.Styles>
        <!--
            Every mappable element's resting ring. These are plain styles rather than
            attributes on the elements because a local value - which is what a XAML
            attribute or a {DynamicResource} compiles to - outranks every activated style in
            Avalonia: an element carrying its own Stroke could never be re-ringed by
            :pointerover, :focus, .pressed or .selected below.

            The shape selectors read ":is(Shape)" rather than "Shape" because a bare type
            selector is CONCRETE in Avalonia: it matches only that exact type, and Shape is
            abstract, so "Shape.padHit" would never match an Ellipse at all.
        -->
        <Style Selector=":is(Shape).padHit">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Stroke" Value="{DynamicResource StickRingBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>
        <Style Selector="Border.padHit">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource StickRingBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--
            Hover: the accent ring. The fade itself is an inline BrushTransition on each
            element, because Avalonia 12.1.4 drops a Transitions Setter from a Style for
            Shapes and Borders.
        -->
        <Style Selector=":is(Shape).padHit:pointerover">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.padHit:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Focus: the keyboard reaches the model too, so a focused element rings as well. -->
        <Style Selector=":is(Shape).padHit:focus">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Border.padHit:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!--
            Press: a deeper accent while the pointer is held. Shapes and Borders never
            receive the :pressed pseudo-class on their own - only PressedMixin controls such
            as Button do - and Avalonia 12.1.4 lets only a control set its own pseudo-classes,
            so the state rides a plain "pressed" class that the code-behind adds from the
            element's bubbling PointerPressed.
        -->
        <Style Selector=":is(Shape).padHit.pressed">
            <Setter Property="Stroke" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Border.padHit.pressed">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!--
            Selection outranks every transient state: declared last so it wins the tie among
            the activated styles, because it is the state that says "this element is being
            edited" and must not be swapped out from under the user mid-edit.
        -->
        <Style Selector=":is(Shape).padHit.selected">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="2.5" />
        </Style>
        <Style Selector="Border.padHit.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
    </UserControl.Styles>

    <!--
        The stage. 620x380 is the design canvas; the Viewbox in MainWindow scales it to the
        column's width, so every coordinate below is in this canvas space and the reference
        proportions survive the scale.
    -->
    <Grid Width="620" Height="380">
        <Canvas x:Name="PadCanvas" Opacity="{Binding IsConnected, Converter={StaticResource ConnectedOpacity}}">

            <!--
                The silhouette is one continuous path: the central mass, the shoulder line and
                both flared grips share the same outline, so no seam can appear between the
                shapes, and the underside stays concave between the grips.
            -->
            <Path x:Name="PadBody" Canvas.Left="40" Canvas.Top="34" Width="540" Height="306"
                  Fill="{DynamicResource PadBodyBrush}" Stroke="{DynamicResource PadBodyStrokeBrush}"
                  StrokeThickness="1" Effect="{DynamicResource PadShadowEffect}"
                  Data="M 110,16 C 120,2 145,0 170,4
                        C 220,12 320,12 370,4 C 395,0 420,2 430,16
                        C 452,42 462,86 480,136 L 518,238
                        C 528,266 516,294 494,300 C 470,306 448,282 424,254
                        L 386,214 C 362,190 336,180 310,186
                        C 282,192 258,192 230,186 C 204,180 178,190 154,214
                        L 116,254 C 92,282 70,306 46,300 C 24,294 12,266 22,238
                        L 60,136 C 78,86 88,42 110,16 Z" />

            <!--
                LT/RT emerge from BEHIND the shoulder line: each trigger's lower edge dips
                below its bumper's top edge, so the bumper reads as the near surface and the
                trigger as the one reaching out from behind it.
            -->
            <Border x:Name="LeftTrigger" Classes="padHit" Canvas.Left="112" Canvas.Top="10" Width="112" Height="36"
                    CornerRadius="18" Background="{Binding IsLeftTriggerPressed, Converter={StaticResource PadBrush}}"
                    ToolTip.Tip="左扳机 LT" PointerPressed="OnElementPressed" Tag="Button:LeftTrigger">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border x:Name="RightTrigger" Classes="padHit" Canvas.Left="396" Canvas.Top="10" Width="112" Height="36"
                    CornerRadius="18" Background="{Binding IsRightTriggerPressed, Converter={StaticResource PadBrush}}"
                    ToolTip.Tip="右扳机 RT" PointerPressed="OnElementPressed" Tag="Button:RightTrigger">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- LB/RB sit ON the shoulder line: each overlaps the body's top edge, so the
                 shoulder is continuous with the body instead of a bar floating over a gap. -->
            <Border x:Name="LeftBumper" Classes="padHit" Canvas.Left="100" Canvas.Top="28" Width="136" Height="28"
                    CornerRadius="14" Background="{Binding IsLeftBumperPressed, Converter={StaticResource PadBrush}}"
                    ToolTip.Tip="左肩键 LB" PointerPressed="OnElementPressed" Tag="Button:LeftBumper">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border x:Name="RightBumper" Classes="padHit" Canvas.Left="384" Canvas.Top="28" Width="136" Height="28"
                    CornerRadius="14" Background="{Binding IsRightBumperPressed, Converter={StaticResource PadBrush}}"
                    ToolTip.Tip="右肩键 RB" PointerPressed="OnElementPressed" Tag="Button:RightBumper">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!--
                The left stick: high and outboard, in a recessed well. The well is the
                darker step of the dark-theme ladder, the ring marks the cap's travel, and
                the thumb rides the sampled axes.
            -->
            <Ellipse x:Name="LeftStickWell" Canvas.Left="80" Canvas.Top="112" Width="100" Height="100"
                     Fill="{DynamicResource PadWellBrush}" Stroke="{DynamicResource StickPadStrokeBrush}"
                     StrokeThickness="1" IsHitTestVisible="False" />
            <Border x:Name="LeftStickPadHit" Canvas.Left="80" Canvas.Top="112" Width="100" Height="100"
                    Background="Transparent" Tag="Stick:Left" />
            <Ellipse x:Name="LeftStickPad" Classes="padHit" Canvas.Left="80" Canvas.Top="112" Width="100" Height="100"
                     Fill="{DynamicResource StickPadBrush}"
                     PointerPressed="OnElementPressed" Tag="Stick:Left" ToolTip.Tip="左摇杆">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>
            <Ellipse x:Name="LeftStickRing" Canvas.Left="100" Canvas.Top="132" Width="60" Height="60"
                     Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False" />
            <Ellipse x:Name="LeftStickThumb" Canvas.Left="107" Canvas.Top="139" Width="46" Height="46"
                     Fill="{DynamicResource StickThumbBrush}" IsHitTestVisible="False" />
            <Border x:Name="LeftStickClickHit" Canvas.Left="121" Canvas.Top="222" Width="18" Height="18"
                    Background="Transparent" Tag="Button:LeftStick" />
            <Ellipse x:Name="LeftStickClick" Classes="padHit" Canvas.Left="121" Canvas.Top="222" Width="18" Height="18"
                     Fill="{Binding IsLeftStickPressed, Converter={StaticResource PadBrush}}"
                     PointerPressed="OnElementPressed" Tag="Button:LeftStick" ToolTip.Tip="左摇杆按下">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>

            <!--
                The right stick: low and inboard, below and to the right of the D-pad, which
                is the asymmetry the reference measures.
            -->
            <Ellipse x:Name="RightStickWell" Canvas.Left="440" Canvas.Top="176" Width="100" Height="100"
                     Fill="{DynamicResource PadWellBrush}" Stroke="{DynamicResource StickPadStrokeBrush}"
                     StrokeThickness="1" IsHitTestVisible="False" />
            <Border x:Name="RightStickPadHit" Canvas.Left="440" Canvas.Top="176" Width="100" Height="100"
                    Background="Transparent" Tag="Stick:Right" />
            <Ellipse x:Name="RightStickPad" Classes="padHit" Canvas.Left="440" Canvas.Top="176" Width="100" Height="100"
                     Fill="{DynamicResource StickPadBrush}"
                     PointerPressed="OnElementPressed" Tag="Stick:Right" ToolTip.Tip="右摇杆">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>
            <Ellipse x:Name="RightStickRing" Canvas.Left="460" Canvas.Top="196" Width="60" Height="60"
                     Stroke="{DynamicResource StickRingBrush}" StrokeThickness="1" StrokeDashArray="2,2" IsHitTestVisible="False" />
            <Ellipse x:Name="RightStickThumb" Canvas.Left="467" Canvas.Top="203" Width="46" Height="46"
                     Fill="{DynamicResource StickThumbBrush}" IsHitTestVisible="False" />
            <Border x:Name="RightStickClickHit" Canvas.Left="481" Canvas.Top="286" Width="18" Height="18"
                    Background="Transparent" Tag="Button:RightStick" />
            <Ellipse x:Name="RightStickClick" Classes="padHit" Canvas.Left="481" Canvas.Top="286" Width="18" Height="18"
                     Fill="{Binding IsRightStickPressed, Converter={StaticResource PadBrush}}"
                     PointerPressed="OnElementPressed" Tag="Button:RightStick" ToolTip.Tip="右摇杆按下">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>

            <!--
                The D-pad: a cross inside a circular tray. The tray is the recessed well the
                cross sits in, so the four arms read as one raised cross rather than four
                separate bars floating on the body.
            -->
            <Ellipse x:Name="DpadTray" Canvas.Left="196" Canvas.Top="198" Width="104" Height="104"
                     Fill="{DynamicResource PadWellBrush}" Stroke="{DynamicResource StickPadStrokeBrush}"
                     StrokeThickness="1" IsHitTestVisible="False" />
            <Border x:Name="DpadUp" Classes="padHit" Canvas.Left="234" Canvas.Top="204" Width="28" Height="46"
                    CornerRadius="4" Background="{Binding IsDPadUpPressed, Converter={StaticResource PadBrush}}"
                    PointerPressed="OnElementPressed" Tag="Button:DPadUp" ToolTip.Tip="十字键 上">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border x:Name="DpadDown" Classes="padHit" Canvas.Left="234" Canvas.Top="250" Width="28" Height="46"
                    CornerRadius="4" Background="{Binding IsDPadDownPressed, Converter={StaticResource PadBrush}}"
                    PointerPressed="OnElementPressed" Tag="Button:DPadDown" ToolTip.Tip="十字键 下">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border x:Name="DpadLeft" Classes="padHit" Canvas.Left="202" Canvas.Top="234" Width="46" Height="28"
                    CornerRadius="4" Background="{Binding IsDPadLeftPressed, Converter={StaticResource PadBrush}}"
                    PointerPressed="OnElementPressed" Tag="Button:DPadLeft" ToolTip.Tip="十字键 左">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Border x:Name="DpadRight" Classes="padHit" Canvas.Left="248" Canvas.Top="234" Width="46" Height="28"
                    CornerRadius="4" Background="{Binding IsDPadRightPressed, Converter={StaticResource PadBrush}}"
                    PointerPressed="OnElementPressed" Tag="Button:DPadRight" ToolTip.Tip="十字键 右">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Border.Transitions>
            </Border>
            <Ellipse x:Name="DpadCenter" Canvas.Left="234" Canvas.Top="234" Width="28" Height="28"
                     Fill="{DynamicResource DpadCenterBrush}" IsHitTestVisible="False" />

            <!--
                ABXY on an EQUAL diamond: the horizontal and vertical gaps between
                neighbouring centres match, so the cluster is a square standing on its corner
                rather than the 1:2 stretch the old model drew. Each face button and its
                letter share one panel - a Shape cannot hold a child in Avalonia, so the
                button moves, the letter moves with it, and neither can drift out of centre.
            -->
            <Canvas Canvas.Left="373" Canvas.Top="117" Width="30" Height="30" Background="Transparent" Tag="Button:Y">
                <Ellipse x:Name="ButtonY" Classes="padHit" Width="30" Height="30"
                         Fill="{Binding IsYPressed, Converter={StaticResource PadBrush}}"
                         PointerPressed="OnElementPressed" Tag="Button:Y">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
                <TextBlock Width="30" Height="30" LineHeight="30" Text="Y" FontSize="14"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>
            <Canvas Canvas.Left="343" Canvas.Top="147" Width="30" Height="30" Background="Transparent" Tag="Button:X">
                <Ellipse x:Name="ButtonX" Classes="padHit" Width="30" Height="30"
                         Fill="{Binding IsXPressed, Converter={StaticResource PadBrush}}"
                         PointerPressed="OnElementPressed" Tag="Button:X">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
                <TextBlock Width="30" Height="30" LineHeight="30" Text="X" FontSize="14"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>
            <Canvas Canvas.Left="403" Canvas.Top="147" Width="30" Height="30" Background="Transparent" Tag="Button:B">
                <Ellipse x:Name="ButtonB" Classes="padHit" Width="30" Height="30"
                         Fill="{Binding IsBPressed, Converter={StaticResource PadBrush}}"
                         PointerPressed="OnElementPressed" Tag="Button:B">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
                <TextBlock Width="30" Height="30" LineHeight="30" Text="B" FontSize="14"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>
            <Canvas Canvas.Left="373" Canvas.Top="177" Width="30" Height="30" Background="Transparent" Tag="Button:A">
                <Ellipse x:Name="ButtonA" Classes="padHit" Width="30" Height="30"
                         Fill="{Binding IsAPressed, Converter={StaticResource PadBrush}}"
                         PointerPressed="OnElementPressed" Tag="Button:A">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
                <TextBlock Width="30" Height="30" LineHeight="30" Text="A" FontSize="14"
                           Foreground="{DynamicResource PadLabelBrush}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Canvas>

            <!--
                The centre cluster is hierarchical: a large Guide flanked by the smaller View
                and Menu buttons on the shared centre line, rather than three equal dots.
            -->
            <Border x:Name="BackButtonHit" Canvas.Left="252" Canvas.Top="96" Width="18" Height="18"
                    Background="Transparent" Tag="Button:Back" />
            <Ellipse x:Name="BackButton" Classes="padHit" Canvas.Left="252" Canvas.Top="96" Width="18" Height="18"
                     Fill="{Binding IsBackPressed, Converter={StaticResource PadBrush}}"
                     ToolTip.Tip="返回键 Back" PointerPressed="OnElementPressed" Tag="Button:Back">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>
            <Border x:Name="GuideButtonHit" Canvas.Left="278" Canvas.Top="90" Width="30" Height="30"
                    Background="Transparent" Tag="Button:Guide" />
            <Ellipse x:Name="GuideButton" Classes="padHit" Canvas.Left="278" Canvas.Top="90" Width="30" Height="30"
                     Fill="{Binding IsGuidePressed, Converter={StaticResource PadBrush}}"
                     ToolTip.Tip="主页键 Guide" PointerPressed="OnElementPressed" Tag="Button:Guide">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>
            <Border x:Name="StartButtonHit" Canvas.Left="316" Canvas.Top="96" Width="18" Height="18"
                    Background="Transparent" Tag="Button:Start" />
            <Ellipse x:Name="StartButton" Classes="padHit" Canvas.Left="316" Canvas.Top="96" Width="18" Height="18"
                     Fill="{Binding IsStartPressed, Converter={StaticResource PadBrush}}"
                     ToolTip.Tip="开始键 Start" PointerPressed="OnElementPressed" Tag="Button:Start">
                <Ellipse.Transitions>
                    <Transitions>
                        <BrushTransition Property="Stroke" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                    </Transitions>
                </Ellipse.Transitions>
            </Ellipse>

            <!-- Unmapped evdev codes, drawn as pills under the pad body. -->
            <ItemsControl x:Name="ExtraButtonsHost" Canvas.Left="60" Canvas.Top="352" Width="500"
                          ItemsSource="{Binding ExtraButtonCodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="padHit" Tag="{Binding}" Background="{DynamicResource SubtleBrush}"
                                CornerRadius="6" Padding="9,2" Height="24"
                                PointerPressed="OnExtraButtonPressed">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionDurationFast}" Easing="{DynamicResource MotionEaseStandard}" />
                                </Transitions>
                            </Border.Transitions>
                            <TextBlock Text="{Binding StringFormat='按键 {0}'}" FontSize="13"
                                       Foreground="{DynamicResource ControlForegroundBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <TextBlock x:Name="DisconnectedLabel" Text="未连接" IsVisible="{Binding IsConnected, Converter={StaticResource Not}}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                   FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
