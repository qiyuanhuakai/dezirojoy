<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             xmlns:conv="clr-namespace:DeziroJoy.App.Views.Converters"
             x:Class="DeziroJoy.App.Views.Controls.DaemonSettingsCard"
             x:DataType="vm:DaemonSettingsViewModel">
    <UserControl.Resources>
        <conv:BoolNegationConverter x:Key="Not" />
    </UserControl.Resources>
    <Border Classes="card">
        <StackPanel>
            <TextBlock Classes="cardTitle" Text="后台服务" />

            <TextBlock Classes="fieldLabel" Margin="0,12,0,0" x:Name="DaemonStateText"
                       Text="{Binding DaemonStateText}" />
            <!-- Linux only: the unit's own login-autostart state on its own line, so "enabled"
                 can never be read as "running" - systemd decides the two separately, and the
                 user's "每次刷新都显示未启用" was exactly that conflation. -->
            <TextBlock Classes="hint" Margin="0,2,0,0" TextWrapping="Wrap"
                       x:Name="DaemonEnabledText"
                       IsVisible="{Binding HasDaemonEnabledText}"
                       Text="{Binding DaemonEnabledText}" />
            <!-- ...and when that 未启用 has a reason the plain line cannot say - systemd cannot
                 see the unit file at all, or the unit can never auto-start - the reason is
                 stated here instead of leaving the user to guess at the toggle. -->
            <TextBlock Classes="hint" Margin="0,2,0,0" TextWrapping="Wrap"
                       x:Name="DaemonEnablementNote"
                       IsVisible="{Binding HasDaemonEnablementNote}"
                       Text="{Binding DaemonEnablementNote}" />
            <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding ElevationText}" />

            <!-- Linux only: the one-click device-access fix. The installers deliberately never
                 register udev rules (opt-in), so this button is the user's explicit action -
                 and its tooltip states what it changes (/etc/udev/rules.d + input group, with a
                 re-login) before they take it. Without a polkit agent the fix degrades to the
                 same commands as copyable text, and the tooltip says why. -->
            <StackPanel IsVisible="{Binding IsSameUserModel}" x:Name="DeviceAccessFixRow" Margin="0,10,0,0">
                <TextBlock Classes="hint" TextWrapping="Wrap" x:Name="DeviceAccessStatusText"
                           Text="{Binding DeviceAccessStatusText}" />
                <TextBlock Classes="hint" Margin="0,3,0,0" TextWrapping="Wrap"
                           x:Name="DeviceAccessConfigurationText" Text="{Binding DeviceAccessConfigurationText}" />
                <TextBlock Classes="hint" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="{Binding DeviceAccessMethodText}" />
                <Button Classes="ghost" Margin="0,8,0,0" Content="{Binding DeviceAccessFixButtonText}"
                        x:Name="FixDeviceAccessButton"
                        IsEnabled="{Binding CanFixDeviceAccess}"
                        ToolTip.Tip="{Binding DeviceAccessFixTooltip}"
                        Command="{Binding FixDeviceAccessCommand}" />
                <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                           x:Name="DeviceAccessFixStatus"
                           IsVisible="{Binding HasDeviceAccessFixStatus}"
                           Text="{Binding DeviceAccessFixStatus}" />
            </StackPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button Classes="ghost" Margin="0,0,8,8" Content="安装常驻"
                        IsEnabled="{Binding IsSupported}" Command="{Binding InstallDaemonCommand}" />
                <Button Classes="ghost" Margin="0,0,8,8" Content="卸载常驻"
                        IsEnabled="{Binding IsSupported}" Command="{Binding UninstallDaemonCommand}" />
                <Button Classes="ghost" Margin="0,0,8,8" Content="刷新"
                        IsEnabled="{Binding IsSupported}" Command="{Binding RefreshCommand}" />
            </WrapPanel>

            <!-- Linux only: the systemd user unit starts and stops on its own, separately from
                 installing or uninstalling it. Windows has no such split - a scheduled task
                 either exists and runs at logon or does not - so the row stays hidden there. -->
            <WrapPanel IsVisible="{Binding IsSameUserModel}" x:Name="DaemonRuntimeRow">
                <Button Classes="ghost" Margin="0,0,8,8" Content="启动常驻"
                        x:Name="StartDaemonButton"
                        IsEnabled="{Binding CanStartDaemon}" Command="{Binding StartDaemonCommand}" />
                <Button Classes="ghost" Margin="0,0,8,8" Content="停止常驻"
                        x:Name="StopDaemonButton"
                        IsEnabled="{Binding CanStopDaemon}" Command="{Binding StopDaemonCommand}" />
            </WrapPanel>

            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                <StackPanel>
                    <CheckBox Content="登录时自启动" IsEnabled="{Binding IsSupported}"
                              IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />
                    <!-- The one limit the checkbox label cannot say: installing or removing
                         the scheduled task needs the administrator token. A systemd user
                         unit needs no administrator, so Linux has nothing to say here and
                         the line stays hidden. -->
                    <TextBlock Classes="hint" Margin="0,6,0,0" TextWrapping="Wrap"
                               x:Name="AutostartHintText"
                               IsVisible="{Binding IsSameUserModel, Converter={StaticResource Not}}"
                               Text="安装或卸载需要管理员权限。" />
                </StackPanel>
            </Border>

            <!-- The input backend: SDL3 is the default since S3; the legacy XInput/evdev
                 backend is the explicit fallback for configurations that still live under the
                 old device identities. A switch persists the selection and safely restarts the
                 daemon - the provider is built at daemon startup and cannot be hot-swapped -
                 and the running backend the daemon reports is shown beside it, so a selection
                 that has not taken effect (or a start that failed) is visible instead of
                 implied. -->
            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Classes="fieldLabel" Text="输入后端" />
                    <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                               x:Name="BackendIntroText"
                               Text="切换后重启常驻服务生效；启动失败时保持原后端，不会静默更换。" />
                    <RadioButton Margin="0,8,0,0" Content="SDL3 统一后端（默认）"
                                 x:Name="Sdl3BackendOption"
                                 IsChecked="{Binding IsSdl3BackendSelected, Mode=TwoWay}" />
                    <RadioButton Margin="0,4,0,0" Content="旧后端回退（XInput / evdev）"
                                 x:Name="LegacyBackendOption"
                                 IsChecked="{Binding IsLegacyBackendSelected, Mode=TwoWay}" />
                    <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap"
                               x:Name="RunningBackendText" Text="{Binding RunningBackendText}" />
                    <TextBlock Classes="hint" Margin="0,2,0,0" TextWrapping="Wrap"
                               x:Name="RunningBackendErrorText"
                               IsVisible="{Binding HasRunningBackendError}"
                               Text="{Binding RunningBackendErrorText}" />
                    <TextBlock Classes="hint" Margin="0,2,0,0" TextWrapping="Wrap"
                               x:Name="BackendMismatchText"
                               IsVisible="{Binding HasBackendMismatch}"
                               Text="{Binding BackendMismatchText}" />
                    <Button Classes="ghost" Margin="0,8,0,0" Padding="10,4"
                            Content="保存并重启常驻服务" x:Name="ApplyBackendButton"
                            Command="{Binding ApplyBackendCommand}" />
                    <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                               x:Name="BackendStatusText"
                               IsVisible="{Binding HasBackendStatusMessage}"
                               Text="{Binding BackendStatusMessage}" />
                </StackPanel>
            </Border>

            <!-- The experimental rendering switch, Windows only: the software mode exists on
                 the Win32 backend alone, so the section is not offered anywhere else. Like
                 the input backend it is a persisted request only a restart can apply - the
                 renderer is built once per process - but unlike it there is nothing to
                 restart: the daemon draws nothing, so the card names the main-window restart
                 as what applies it, and claims nothing about what the mode does better. The
                 resident tray host is pinned to software by its own policy (Program.
                 BuildTrayAvaloniaApp) and never reads this selection, which the hints say. -->
            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                    x:Name="RenderModeSection" IsVisible="{Binding IsRenderModeVisible}">
                <StackPanel>
                    <TextBlock Classes="fieldLabel" Text="界面渲染（仅 Windows）" />
                    <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                               x:Name="RenderModeIntroText"
                               Text="实验性开关：强制主窗口仅使用 CPU 软件渲染（Avalonia Win32 Software）。若 Software 无法初始化，应用会启动失败而不会回退。" />
                    <TextBlock Classes="hint" Margin="0,2,0,0" TextWrapping="Wrap"
                               x:Name="RenderModeApplyHintText"
                               Text="保存后重启主程序生效（当前窗口仍按启动时的渲染方式运行）；常驻托盘宿主及其浮层固定使用软件渲染，不受此设置影响。临时覆盖：DEZIROJOY_RENDER=software|default 或 --render=software|default，优先于本设置。" />
                    <RadioButton Margin="0,8,0,0" Content="平台检测（默认）"
                                 x:Name="DefaultRenderOption"
                                 IsChecked="{Binding IsDefaultRenderSelected, Mode=TwoWay}" />
                    <RadioButton Margin="0,4,0,0" Content="软件渲染 Software（实验）"
                                 x:Name="SoftwareRenderOption"
                                 IsChecked="{Binding IsSoftwareRenderSelected, Mode=TwoWay}" />
                    <Button Classes="ghost" Margin="0,8,0,0" Padding="10,4"
                            Content="保存渲染设置" x:Name="ApplyRenderModeButton"
                            Command="{Binding ApplyRenderModeCommand}" />
                    <TextBlock Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap"
                               x:Name="RenderModeStatusText"
                               IsVisible="{Binding HasRenderModeStatusMessage}"
                               Text="{Binding RenderModeStatusMessage}" />
                </StackPanel>
            </Border>

            <TextBlock Classes="hint" Margin="0,10,0,0" TextWrapping="Wrap"
                       x:Name="DaemonStatusText"
                       IsVisible="{Binding HasStatusMessage}"
                       Foreground="{DynamicResource AccentBrush}"
                       Text="{Binding StatusMessage}" />
        </StackPanel>
    </Border>
</UserControl>
