<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DeziroJoy.App.ViewModels"
             x:Class="DeziroJoy.App.Views.Controls.ResponseCurveGraph"
             x:DataType="vm:MouseSensitivityViewModel">
    <Border Width="260" Height="160" Background="{DynamicResource SunkenBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid Margin="34,14,14,28">
            <Canvas x:Name="PlotCanvas" Width="200" Height="110" HorizontalAlignment="Left" VerticalAlignment="Top">

                <Rectangle x:Name="DiagonalReference" Canvas.Left="-14.1" Canvas.Top="54"
                           Width="228.2" Height="2" Fill="{DynamicResource ControlBorderBrush}">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-28.8" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <Polyline x:Name="CurvePolyline" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                          StrokeJoin="Round" StrokeLineCap="Round" />
            </Canvas>

            <TextBlock Text="输出" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="-24,0,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="输入" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,-2,-20" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>
    </Border>
</UserControl>
