<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DeziroJoy theme token layer.

        Every colour that used to be hardcoded in MainWindow.axaml and the three
        UserControls now lives here as a named token, with a Dark value that
        reproduces the original hex exactly and a Light value chosen for
        readability (WCAG AA text contrast, perceptible borders) rather than by
        inverting the dark one.

        Consumption rules:
          * Always resolve these keys with {DynamicResource ...}. A
            {StaticResource ...} lookup against a ThemeDictionaries key is not
            supported and throws at runtime.
          * The eight tokens that already existed at Window scope in
            MainWindow.axaml (AccentBrush, ConnectedBrush, IdleDotBrush,
            CardBrush, CardBorderBrush, SubtleBrush, TextPrimaryBrush,
            TextSecondaryBrush) are deliberately re-declared here at
            Application scope under the same names, so deleting the
            Window-scope block later makes every existing
            {StaticResource ...} reference resolve straight onto the themed
            token with no rename.
          * "Default" mirrors Dark. It is the fallback the resource system
            consults when the live variant has no entry for a key, and keeping
            it dark preserves the app's default look before ThemeService has
            applied the persisted preference.
    -->

    <!--
        Corner-radius scale. Theme-independent, so it lives once at the root rather than
        in every ThemeDictionary. A small deliberate scale - not one number everywhere:
          Sm (4)  chips, badges, pills
          Md (6)  form controls: buttons, inputs, combos, toggles, list rows
          Lg (8)  primary buttons and inset wells
          Xl (12) cards and panels
        Consume with {DynamicResource CornerRadius...}; a Border that must clip its
        children to the rounded shape also sets ClipToBounds="True".
    -->
    <CornerRadius x:Key="CornerRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMd">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXl">12</CornerRadius>

    <!--
        Motion scale. Theme-independent, so it lives here at the root for the same reason the
        corner-radius scale does: a duration is a property of the interaction, not of the
        variant. Three steps, all inside the 150-300ms band that reads as responsive rather
        than sluggish:
          Fast (150ms) selection feedback: the mapping row's tint
          Base (220ms) surface appearance: the editor card's slide and fade
          Slow (280ms) the larger move: the model lifting out of the editor's way
        Consume with {DynamicResource MotionDuration...} on a DoubleTransition's Duration.
    -->
    <x:TimeSpan x:Key="MotionDurationFast">0:0:0.15</x:TimeSpan>
    <x:TimeSpan x:Key="MotionDurationBase">0:0:0.22</x:TimeSpan>
    <x:TimeSpan x:Key="MotionDurationSlow">0:0:0.28</x:TimeSpan>

    <!--
        Motion easing. Theme-independent for the same reason the durations are: an easing curve
        is a property of the interaction, not of the variant. CubicEaseOut is the app's one
        house curve - a fast start that settles gently, which reads as responsive without the
        linear "robotic" ramp or the overshoot of a back/elastic ease. Centralised here so the
        duration tokens and the easing token are consumed the same way:
        Duration="{DynamicResource MotionDuration...}" Easing="{DynamicResource MotionEaseStandard}".
    -->
    <CubicEaseOut x:Key="MotionEaseStandard" />

    <!-- Shared translucent materials keep physical pressed colours visible beneath them. -->
    <LinearGradientBrush x:Key="PadControlGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.45" />
        <GradientStop Color="#38000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PadShellSheenBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StickCapSheenBrush" StartPoint="0.15,0" EndPoint="0.8,1">
        <GradientStop Color="#48FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.5" />
        <GradientStop Color="#48000000" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="PadControlShadowEffect" Color="#000000" Opacity="0.3"
                      BlurRadius="4" OffsetX="0" OffsetY="2" />

    <!--
        Slider geometry. Theme-independent, so it lives here at app scope where the slider
        ControlTheme (Themes/Slider.axaml) can reach it with {DynamicResource}. The track
        height is consumed by the inner TrackBackground border of the RepeatButton template,
        which is the only place it takes effect - not Track.Height.
    -->
    <x:Double x:Key="SliderHorizontalHeight">34</x:Double>
    <x:Double x:Key="SliderVerticalWidth">34</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">6</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">20</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">20</x:Double>
    <x:Double x:Key="SliderVerticalThumbWidth">20</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">20</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SliderTrackCornerRadius">3</CornerRadius>

    <ResourceDictionary.ThemeDictionaries>

        <!-- ======================= FALLBACK (mirrors Dark) ======================= -->
        <ResourceDictionary x:Key="Default">

            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#161616" />
            <SolidColorBrush x:Key="PanelBrush" Color="#141414" />
            <SolidColorBrush x:Key="CardBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SunkenBrush" Color="#151515" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#232323" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#1E3A48" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#1F2E38" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#DD151515" />

            <!-- Borders, dividers, tracks -->
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="PreviewBorderBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="TrackBrush" Color="#242424" />
            <!-- Slider: the unfilled track is a step lighter than the card so the filled
                 accent portion reads as deliberate; the thumb is white in both themes. -->
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="HintTextBrush" Color="#7A7A7A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ControlForegroundBrush" Color="#DADADA" />
            <SolidColorBrush x:Key="ToggleForegroundBrush" Color="#B4B4B4" />
            <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#D0D0D0" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#B9B9B9" />
            <SolidColorBrush x:Key="OverlayTextBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="PadLabelBrush" Color="#D9DDE3" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="DangerForegroundBrush" Color="#D0D0D0" />

            <!-- Accent and status -->
            <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FCFFF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#6FCFFF" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="IdleDotBrush" Color="#6E7681" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

            <!-- Pearl shell, graphite hardware and cool machined edges. -->
            <SolidColorBrush x:Key="PadBodyBrush" Color="#E8E9E7" />
            <LinearGradientBrush x:Key="PadShellSurfaceBrush" StartPoint="0.15,0" EndPoint="0.75,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#E8E9E7" Offset="0.48" />
                <GradientStop Color="#C8CDD2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PadGripBrush" StartPoint="0,0" EndPoint="1,0.8">
                <GradientStop Color="#DDE0E3" Offset="0" />
                <GradientStop Color="#B9BEC5" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StickWellBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C4C9CE" Offset="0" />
                <GradientStop Color="#F0F1F2" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="StickAccentRingBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="StickPadBrush" Color="#181B20" />
            <SolidColorBrush x:Key="StickPadStrokeBrush" Color="#68717B" />
            <SolidColorBrush x:Key="StickRingBrush" Color="#707984" />
            <SolidColorBrush x:Key="StickThumbBrush" Color="#32373F" />
            <SolidColorBrush x:Key="StickBevelBrush" Color="#737D88" />
            <SolidColorBrush x:Key="StickTreadBrush" Color="#7E8792" />
            <SolidColorBrush x:Key="DpadCenterBrush" Color="#181B20" />
            <SolidColorBrush x:Key="PadIdleBrush" Color="#161616" />
            <SolidColorBrush x:Key="PadPressedBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="PadWellBrush" Color="#D4D7DA" />
            <SolidColorBrush x:Key="PadCapBrush" Color="#171A1F" />
            <SolidColorBrush x:Key="PadBodyStrokeBrush" Color="#B9BEC5" />
            <SolidColorBrush x:Key="PadGripEdgeBrush" Color="#AAB2BB" />
            <SolidColorBrush x:Key="PadGripTextureBrush" Color="#68727E" />
            <SolidColorBrush x:Key="PadSeamBrush" Color="#9FA8B2" />
            <SolidColorBrush x:Key="PadInsetLineBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="PadControlEdgeBrush" Color="#52FFFFFF" />
            <DropShadowEffect x:Key="PadShadowEffect" Color="#000000" Opacity="0.5"
                              BlurRadius="18" OffsetX="0" OffsetY="7" />

        </ResourceDictionary>

        <!-- =============================== LIGHT =============================== -->
        <ResourceDictionary x:Key="Light">

            <!--
                Surfaces. The canvas is a cool light grey so white cards read as
                raised; the title bar and the right-hand status panel invert
                their dark-mode relationship and sit above the canvas.
            -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8FA" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SunkenBrush" Color="#F6F8FA" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#F0F2F5" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#E9EDF1" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E9EDF1" />
            <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#E6F1F9" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#E6F1F9" />
            <!-- Translucent scrim over the sunken preview well; keeps the speed pill legible. -->
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#3324292E" />

            <!-- Borders, dividers, tracks -->
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D0D7DE" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#AFB8C1" />
            <SolidColorBrush x:Key="PreviewBorderBrush" Color="#C9D1D9" />
            <SolidColorBrush x:Key="TrackBrush" Color="#C9D1D9" />
            <!-- Slider: the unfilled track is a step darker than the white card so the
                 filled accent portion reads as deliberate; the thumb stays white. -->
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#D8DEE4" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />

            <!--
                Text. Every value clears 4.5:1 on both the white card and the
                #F6F8FA canvas, so the same token is safe on either surface.
            -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#59636E" />
            <SolidColorBrush x:Key="HintTextBrush" Color="#656E78" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#5C6470" />
            <SolidColorBrush x:Key="ControlForegroundBrush" Color="#24292F" />
            <SolidColorBrush x:Key="ToggleForegroundBrush" Color="#24292F" />
            <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#57606A" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#57606A" />
            <SolidColorBrush x:Key="OverlayTextBrush" Color="#1F2328" />
            <SolidColorBrush x:Key="PadLabelBrush" Color="#D9DDE3" />
            <!-- Foreground for content sitting on AccentBrush / DangerBrush. -->
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />

            <!--
                Accent and status. The cyan accent is deepened to a sky blue so
                it stays readable as text and as a button fill on white; hover
                and pressed step darker, mirroring how the dark theme steps
                lighter.
            -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0A6FBF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#08599B" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#064E86" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="IdleDotBrush" Color="#57606A" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

            <!-- The light variant uses cooler recesses and stronger edge definition. -->
            <SolidColorBrush x:Key="PadBodyBrush" Color="#EDEEF0" />
            <LinearGradientBrush x:Key="PadShellSurfaceBrush" StartPoint="0.15,0" EndPoint="0.75,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#F0F1F2" Offset="0.48" />
                <GradientStop Color="#D4D8DD" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PadGripBrush" StartPoint="0,0" EndPoint="1,0.8">
                <GradientStop Color="#E5E8EB" Offset="0" />
                <GradientStop Color="#C3C9CF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StickWellBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C9D0D6" Offset="0" />
                <GradientStop Color="#F4F5F6" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="StickAccentRingBrush" Color="#0A6FBF" />
            <SolidColorBrush x:Key="StickPadBrush" Color="#181B20" />
            <SolidColorBrush x:Key="StickPadStrokeBrush" Color="#68717B" />
            <SolidColorBrush x:Key="StickRingBrush" Color="#707984" />
            <SolidColorBrush x:Key="StickThumbBrush" Color="#32373F" />
            <SolidColorBrush x:Key="StickBevelBrush" Color="#737D88" />
            <SolidColorBrush x:Key="StickTreadBrush" Color="#7E8792" />
            <SolidColorBrush x:Key="DpadCenterBrush" Color="#181B20" />
            <SolidColorBrush x:Key="PadIdleBrush" Color="#161616" />
            <SolidColorBrush x:Key="PadPressedBrush" Color="#0A6FBF" />
            <SolidColorBrush x:Key="PadWellBrush" Color="#D9DDE1" />
            <SolidColorBrush x:Key="PadCapBrush" Color="#171A1F" />
            <SolidColorBrush x:Key="PadBodyStrokeBrush" Color="#B6BDC5" />
            <SolidColorBrush x:Key="PadGripEdgeBrush" Color="#AAB2BB" />
            <SolidColorBrush x:Key="PadGripTextureBrush" Color="#68727E" />
            <SolidColorBrush x:Key="PadSeamBrush" Color="#9FA8B2" />
            <SolidColorBrush x:Key="PadInsetLineBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="PadControlEdgeBrush" Color="#52FFFFFF" />
            <DropShadowEffect x:Key="PadShadowEffect" Color="#1F2328" Opacity="0.28"
                              BlurRadius="18" OffsetX="0" OffsetY="7" />

        </ResourceDictionary>

        <!-- =============================== DARK ================================ -->
        <ResourceDictionary x:Key="Dark">

            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#161616" />
            <SolidColorBrush x:Key="PanelBrush" Color="#141414" />
            <SolidColorBrush x:Key="CardBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SunkenBrush" Color="#151515" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#232323" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#1E3A48" />
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#1F2E38" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#DD151515" />

            <!-- Borders, dividers, tracks -->
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="PreviewBorderBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="TrackBrush" Color="#242424" />
            <!-- Slider: the unfilled track is a step lighter than the card so the filled
                 accent portion reads as deliberate; the thumb is white in both themes. -->
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="HintTextBrush" Color="#7A7A7A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ControlForegroundBrush" Color="#DADADA" />
            <SolidColorBrush x:Key="ToggleForegroundBrush" Color="#B4B4B4" />
            <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#D0D0D0" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#B9B9B9" />
            <SolidColorBrush x:Key="OverlayTextBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="PadLabelBrush" Color="#D9DDE3" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="DangerForegroundBrush" Color="#D0D0D0" />

            <!-- Accent and status -->
            <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FCFFF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#6FCFFF" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="IdleDotBrush" Color="#6E7681" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

            <!-- Pearl shell, graphite hardware and cool machined edges. -->
            <SolidColorBrush x:Key="PadBodyBrush" Color="#E8E9E7" />
            <LinearGradientBrush x:Key="PadShellSurfaceBrush" StartPoint="0.15,0" EndPoint="0.75,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#E8E9E7" Offset="0.48" />
                <GradientStop Color="#C8CDD2" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PadGripBrush" StartPoint="0,0" EndPoint="1,0.8">
                <GradientStop Color="#DDE0E3" Offset="0" />
                <GradientStop Color="#B9BEC5" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="StickWellBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C4C9CE" Offset="0" />
                <GradientStop Color="#F0F1F2" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="StickAccentRingBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="StickPadBrush" Color="#181B20" />
            <SolidColorBrush x:Key="StickPadStrokeBrush" Color="#68717B" />
            <SolidColorBrush x:Key="StickRingBrush" Color="#707984" />
            <SolidColorBrush x:Key="StickThumbBrush" Color="#32373F" />
            <SolidColorBrush x:Key="StickBevelBrush" Color="#737D88" />
            <SolidColorBrush x:Key="StickTreadBrush" Color="#7E8792" />
            <SolidColorBrush x:Key="DpadCenterBrush" Color="#181B20" />
            <SolidColorBrush x:Key="PadIdleBrush" Color="#161616" />
            <SolidColorBrush x:Key="PadPressedBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="PadWellBrush" Color="#D4D7DA" />
            <SolidColorBrush x:Key="PadCapBrush" Color="#171A1F" />
            <SolidColorBrush x:Key="PadBodyStrokeBrush" Color="#B9BEC5" />
            <SolidColorBrush x:Key="PadGripEdgeBrush" Color="#AAB2BB" />
            <SolidColorBrush x:Key="PadGripTextureBrush" Color="#68727E" />
            <SolidColorBrush x:Key="PadSeamBrush" Color="#9FA8B2" />
            <SolidColorBrush x:Key="PadInsetLineBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="PadControlEdgeBrush" Color="#52FFFFFF" />
            <DropShadowEffect x:Key="PadShadowEffect" Color="#000000" Opacity="0.5"
                              BlurRadius="18" OffsetX="0" OffsetY="7" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
