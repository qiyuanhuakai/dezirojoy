<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>DeziroJoy.App.Tests</AssemblyName>
    <RootNamespace>DeziroJoy.App.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <!-- Serializes the test collections: these tests share process-wide surfaces - the
         Avalonia dispatcher, named pipes, temp state - and are only isolated from each
         other by scheduling. Parallel collections turned a loaded runner into flaky
         timing (pipe listeners missing tight connect budgets, UI tests interleaving on
         the dispatcher), so the assembly opts out of collection parallelism and runs one
         collection at a time. Tests that exercise concurrency do so inside themselves
         and are unaffected. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DeziroJoy.App\DeziroJoy.App.csproj" />
  </ItemGroup>
</Project>
